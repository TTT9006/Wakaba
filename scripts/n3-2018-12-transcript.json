      "text": "天気がいいから 酸っぽしましょう"
    },
    {
      "start": 6.86,
      "end": 17.1,
      "text": "天気がいいから 酸っぽしましょう"
    },
    {
      "start": 17.1,
      "end": 24.98,
      "text": "参考しましょう"
    },
    {
      "start": 24.98,
      "end": 27.38,
      "text": "問題1"
    },
    {
      "start": 27.38,
      "end": 34.34,
      "text": "問題1ではまず質問を聞いてください"
    },
    {
      "start": 34.34,
      "end": 38.02,
      "text": "それから話を聞いて"
    },
    {
      "start": 38.02,
      "end": 42.86,
      "text": "問題用紙の1から4の中から"
    },
    {
      "start": 42.86,
      "end": 49.48,
      "text": "最も良いものを1つ選んでください"
    },
    {
      "start": 49.48,
      "end": 57.42,
      "text": "では始めます"
    },
    {
      "start": 57.42,
      "end": 59.02,
      "text": "1番"
    },
    {
      "start": 59.02,
      "end": 63.72,
      "text": "液で女の人と液員が話しています"
    },
    {
      "start": 63.72,
      "end": 70.9,
      "text": "女の人はこれからどうしますか?"
    },
    {
      "start": 70.9,
      "end": 76.9,
      "text": "すみません今乗ってきた電車に忘れ物しちゃったんです"
    },
    {
      "start": 76.9,
      "end": 79.62,
      "text": "赤いカバンなんですけど"
    },
    {
      "start": 79.62,
      "end": 83.1,
      "text": "今出た東京雪の電車ですね"
    },
    {
      "start": 83.1,
      "end": 91.26,
      "text": "では次の山川駅に電話してみますので少々お待ちください"
    },
    {
      "start": 91.26,
      "end": 95.78,
      "text": "お客様おにもつ次の駅で見つかりました"
    },
    {
      "start": 95.78,
      "end": 98.62,
      "text": "そうですかよかったー"
    },
    {
      "start": 98.62,
      "end": 100.42,
      "text": "ありがとうございます"
    },
    {
      "start": 100.42,
      "end": 102.42,
      "text": "すぐ取りに行かれますか?"
    },
    {
      "start": 102.42,
      "end": 103.42,
      "text": "はい"
    },
    {
      "start": 103.42,
      "end": 108.62,
      "text": "じゃあ山川駅の話すれものセンターに行ってください"
    },
    {
      "start": 108.62,
      "end": 114.42,
      "text": "明日になりますと東京駅の話すれものセンターに映ってしまいますので"
    },
    {
      "start": 114.42,
      "end": 116.34,
      "text": "気をつけてくださいね"
    },
    {
      "start": 116.34,
      "end": 117.82,
      "text": "わかりました"
    },
    {
      "start": 117.82,
      "end": 121.26,
      "text": "ありがとうございました"
    },
    {
      "start": 122.26,
      "end": 130.26,
      "text": "おんなの人はこれからどうしますか?"
    },
    {
      "start": 130.26,
      "end": 138.26,
      "text": "おんなの人と男の人が話していますか?"
    },
    {
      "start": 138.26,
      "end": 145.26,
      "text": "おんなの人はどこかの人が話していますか?"
    },
    {
      "start": 146.26,
      "end": 147.26,
      "text": "2番"
    },
    {
      "start": 147.26,
      "end": 152.26,
      "text": "会社で女の人と男の人が話しています"
    },
    {
      "start": 152.26,
      "end": 157.26,
      "text": "男の人は今から何をしますか?"
    },
    {
      "start": 159.26,
      "end": 163.26,
      "text": "ねえ11時からの会議の準備どう?"
    },
    {
      "start": 163.26,
      "end": 165.26,
      "text": "部屋の予約してある?"
    },
    {
      "start": 165.26,
      "end": 166.26,
      "text": "うん、したよ"
    },
    {
      "start": 166.26,
      "end": 169.26,
      "text": "いつもと同じ15人入る部屋だよね"
    },
    {
      "start": 169.26,
      "end": 170.26,
      "text": "え?"
    },
    {
      "start": 170.26,
      "end": 173.26,
      "text": "今日の会議は20人でしょう?"
    },
    {
      "start": 173.26,
      "end": 177.26,
      "text": "え?どうしよう小さい会議室を役しちゃった"
    },
    {
      "start": 177.26,
      "end": 180.26,
      "text": "人数確認しなくちゃダメじゃない"
    },
    {
      "start": 180.26,
      "end": 183.26,
      "text": "すぐ事務所に行って大きい部屋に帰って"
    },
    {
      "start": 183.26,
      "end": 184.26,
      "text": "うん"
    },
    {
      "start": 184.26,
      "end": 187.26,
      "text": "あっ20人だったらお弁当も足りない"
    },
    {
      "start": 187.26,
      "end": 188.26,
      "text": "大変"
    },
    {
      "start": 188.26,
      "end": 190.26,
      "text": "お弁当屋さんに連絡して"
    },
    {
      "start": 190.26,
      "end": 193.26,
      "text": "会議室は私がやっとくから"
    },
    {
      "start": 193.26,
      "end": 194.26,
      "text": "うん"
    },
    {
      "start": 195.26,
      "end": 206.26,
      "text": "お弁当の人は今から何をしますか?"
    },
    {
      "start": 207.26,
      "end": 209.26,
      "text": "3番"
    },
    {
      "start": 219.26,
      "end": 225.26,
      "text": "男の学生と女の学生が話しています"
    },
    {
      "start": 225.26,
      "end": 232.26,
      "text": "男の学生は今日から勉強する前に何をしますか?"
    },
    {
      "start": 233.26,
      "end": 235.26,
      "text": "あああ"
    },
    {
      "start": 235.26,
      "end": 237.26,
      "text": "試験が近いのに"
    },
    {
      "start": 237.26,
      "end": 239.26,
      "text": "前番作品に向かっても集中できなくて"
    },
    {
      "start": 239.26,
      "end": 241.26,
      "text": "勉強が進まないんだ"
    },
    {
      "start": 241.26,
      "end": 243.26,
      "text": "良い方法ない?"
    },
    {
      "start": 243.26,
      "end": 245.26,
      "text": "作品の上は片付いてる?"
    },
    {
      "start": 245.26,
      "end": 248.26,
      "text": "物が多いと集中しにくいから"
    },
    {
      "start": 248.26,
      "end": 251.26,
      "text": "うん、結構綺麗好きなんだよ"
    },
    {
      "start": 251.26,
      "end": 252.26,
      "text": "そう"
    },
    {
      "start": 252.26,
      "end": 256.26,
      "text": "えっと私が色々やってみてよかったのは"
    },
    {
      "start": 256.26,
      "end": 258.26,
      "text": "大臭"
    },
    {
      "start": 259.26,
      "end": 262.26,
      "text": "体を動かすと気分切り替えるのに行こうかあるよ"
    },
    {
      "start": 262.26,
      "end": 263.26,
      "text": "なるほど"
    },
    {
      "start": 263.26,
      "end": 267.26,
      "text": "あと勉強の前にちょっと眠るとか"
    },
    {
      "start": 267.26,
      "end": 270.26,
      "text": "その直後は本当に集中できるよ"
    },
    {
      "start": 270.26,
      "end": 274.26,
      "text": "寝る前に好費いっぱい飲めば"
    },
    {
      "start": 274.26,
      "end": 277.26,
      "text": "ちょうど20分ぐらいに目が覚めると思う"
    },
    {
      "start": 277.26,
      "end": 278.26,
      "text": "本当?"
    },
    {
      "start": 278.26,
      "end": 279.26,
      "text": "うん"
    },
    {
      "start": 279.26,
      "end": 284.26,
      "text": "ただそのやり方で結局朝まで寝ちゃったっていう人もいるからな"
    },
    {
      "start": 284.26,
      "end": 288.26,
      "text": "やっぱり対想にしてそれはやめた方がいいね"
    },
    {
      "start": 288.26,
      "end": 291.26,
      "text": "うん、僕も心配"
    },
    {
      "start": 291.26,
      "end": 293.26,
      "text": "早速今日からやってみるよ"
    },
    {
      "start": 293.26,
      "end": 294.26,
      "text": "ありがとう"
    },
    {
      "start": 315.26,
      "end": 317.26,
      "text": "3番"
    },
    {
      "start": 317.26,
      "end": 320.26,
      "text": "4番"
    },
    {
      "start": 320.26,
      "end": 328.26,
      "text": "飲食店で店の人と男の人が話しています"
    },
    {
      "start": 328.26,
      "end": 333.26,
      "text": "男の人は今いくら払いますか?"
    },
    {
      "start": 333.26,
      "end": 335.26,
      "text": "いらっしゃいませ"
    },
    {
      "start": 335.26,
      "end": 338.26,
      "text": "6時から予約をしている松田ですが"
    },
    {
      "start": 338.26,
      "end": 340.26,
      "text": "松田様ですね"
    },
    {
      "start": 341.26,
      "end": 344.26,
      "text": "本日ご名様お食事と飲み物で"
    },
    {
      "start": 344.26,
      "end": 348.26,
      "text": "お一人様3000円コースのご予約ですね"
    },
    {
      "start": 348.26,
      "end": 353.26,
      "text": "え、実は急に一人こられなくなってしまって"
    },
    {
      "start": 353.26,
      "end": 356.26,
      "text": "今から一人分キャンセルできますか"
    },
    {
      "start": 356.26,
      "end": 361.26,
      "text": "すみませんがもうお料理を準備してしまっていますので"
    },
    {
      "start": 361.26,
      "end": 366.26,
      "text": "合計15000円の大金をいただくことになってしまいますが"
    },
    {
      "start": 366.26,
      "end": 368.26,
      "text": "そうですか"
    },
    {
      "start": 368.26,
      "end": 371.26,
      "text": "4名分も12000円にはならないんですね"
    },
    {
      "start": 371.26,
      "end": 373.26,
      "text": "申し訳ありません"
    },
    {
      "start": 373.26,
      "end": 376.26,
      "text": "当日だからしょうがないですね"
    },
    {
      "start": 376.26,
      "end": 378.26,
      "text": "今全員分払ってもいいですか"
    },
    {
      "start": 378.26,
      "end": 381.26,
      "text": "はい、ありがとうございます"
    },
    {
      "start": 381.26,
      "end": 386.26,
      "text": "あのー今コースをご予約いただいたお客様に"
    },
    {
      "start": 386.26,
      "end": 391.26,
      "text": "次から使える2000円の割引件を私しておりますので"
    },
    {
      "start": 391.26,
      "end": 394.26,
      "text": "次にいらっしゃった時にお使いください"
    },
    {
      "start": 394.26,
      "end": 396.26,
      "text": "あ、どうも"
    },
    {
      "start": 402.26,
      "end": 406.26,
      "text": "男の人は今いくら払いますか"
    },
    {
      "start": 407.26,
      "end": 409.26,
      "text": "5番"
    },
    {
      "start": 421.26,
      "end": 423.26,
      "text": "5番"
    },
    {
      "start": 423.26,
      "end": 426.26,
      "text": "大学で事務所の人が"
    },
    {
      "start": 426.26,
      "end": 430.26,
      "text": "留学生に国際交流会について話しています"
    },
    {
      "start": 430.26,
      "end": 433.26,
      "text": "留学生は当日"
    },
    {
      "start": 433.26,
      "end": 437.26,
      "text": "何を持っていかなければなりませんか"
    },
    {
      "start": 437.26,
      "end": 439.26,
      "text": "えー皆さん"
    },
    {
      "start": 439.26,
      "end": 442.26,
      "text": "来週の土曜日は市民体育館で"
    },
    {
      "start": 442.26,
      "end": 446.26,
      "text": "高校生徒の国際交流会が行われますね"
    },
    {
      "start": 446.26,
      "end": 450.26,
      "text": "グループに分かれて国の紹介をするので"
    },
    {
      "start": 450.26,
      "end": 453.26,
      "text": "自分の国の写真を忘れずに"
    },
    {
      "start": 453.26,
      "end": 457.26,
      "text": "ないとイメージが伝わりにくいですからね"
    },
    {
      "start": 457.26,
      "end": 461.26,
      "text": "それから当日はお弁当を持っていくよう"
    },
    {
      "start": 461.26,
      "end": 463.26,
      "text": "前に伝えましたが"
    },
    {
      "start": 463.26,
      "end": 466.26,
      "text": "予定が変わって高校生と一緒に"
    },
    {
      "start": 466.26,
      "end": 469.26,
      "text": "彼を作ることになったのでいりません"
    },
    {
      "start": 469.26,
      "end": 473.26,
      "text": "材料エプロンなどは大学が用意します"
    },
    {
      "start": 473.26,
      "end": 478.26,
      "text": "それから最後に体を動かすゲームをするので"
    },
    {
      "start": 478.26,
      "end": 482.26,
      "text": "大学館で白運動物を事産してください"
    },
    {
      "start": 487.26,
      "end": 489.26,
      "text": "留学生は当日"
    },
    {
      "start": 489.26,
      "end": 493.26,
      "text": "何を持っていかなければなりませんか"
    },
    {
      "start": 507.26,
      "end": 509.26,
      "text": "6番"
    },
    {
      "start": 509.26,
      "end": 515.26,
      "text": "女の人と男の人が花火大会について話しています"
    },
    {
      "start": 515.26,
      "end": 519.26,
      "text": "女の人はどこで花火を見ますか"
    },
    {
      "start": 519.26,
      "end": 525.26,
      "text": "山田君、来週海外から友達が来るから"
    },
    {
      "start": 525.26,
      "end": 528.26,
      "text": "中川祭の花火に行きたいんだけど"
    },
    {
      "start": 528.26,
      "end": 531.26,
      "text": "山田君のうち近くだよね"
    },
    {
      "start": 531.26,
      "end": 534.26,
      "text": "花火見るのにいい場所ある?"
    },
    {
      "start": 534.26,
      "end": 536.26,
      "text": "中川小学校のグラウンドは"
    },
    {
      "start": 536.26,
      "end": 540.26,
      "text": "広いから祭の会場にもなってるんだよ"
    },
    {
      "start": 540.26,
      "end": 543.26,
      "text": "込むから座ってみたいなら"
    },
    {
      "start": 543.26,
      "end": 546.26,
      "text": "責取るのにかなり早く行かなきゃなんないけどね"
    },
    {
      "start": 546.26,
      "end": 549.26,
      "text": "うちも家族でそこで見るんだ"
    },
    {
      "start": 549.26,
      "end": 552.26,
      "text": "水手るところがいいなら緑橋の上"
    },
    {
      "start": 552.26,
      "end": 556.26,
      "text": "駅からちょっと遠いけどよく見えるよ"
    },
    {
      "start": 556.26,
      "end": 559.26,
      "text": "山田君の家からは見えないの?"
    },
    {
      "start": 559.26,
      "end": 562.26,
      "text": "そうなんだよちょうど前にビルがあって"
    },
    {
      "start": 562.26,
      "end": 566.26,
      "text": "あ、せっかく海外から来るなら船で見たら"
    },
    {
      "start": 566.26,
      "end": 569.26,
      "text": "中川に船が出るんだよ"
    },
    {
      "start": 569.26,
      "end": 571.26,
      "text": "一人5千円くらいかかるけど"
    },
    {
      "start": 571.26,
      "end": 573.26,
      "text": "うなくが必要だよね"
    },
    {
      "start": 573.26,
      "end": 576.26,
      "text": "ああ、もうようやく取れないな"
    },
    {
      "start": 576.26,
      "end": 578.26,
      "text": "人気あるから"
    },
    {
      "start": 578.26,
      "end": 580.26,
      "text": "友達って何人?"
    },
    {
      "start": 580.26,
      "end": 581.26,
      "text": "一人"
    },
    {
      "start": 581.26,
      "end": 584.26,
      "text": "それなら祭の会場で一緒に見ようよ"
    },
    {
      "start": 584.26,
      "end": 588.26,
      "text": "二人分なら家族の分と一緒に責取っとくから"
    },
    {
      "start": 588.26,
      "end": 589.26,
      "text": "本当?"
    },
    {
      "start": 589.26,
      "end": 591.26,
      "text": "じゃあ、エルナク"
    },
    {
      "start": 592.26,
      "end": 594.26,
      "text": "どこで花火を見ますか?"
    },
    {
      "start": 615.26,
      "end": 617.26,
      "text": "問題2"
    },
    {
      "start": 618.26,
      "end": 623.26,
      "text": "問題2ではまず質問を聞いてください"
    },
    {
      "start": 624.26,
      "end": 628.26,
      "text": "その後、問題用紙を見てください"
    },
    {
      "start": 630.26,
      "end": 632.26,
      "text": "読む時間があります"
    },
    {
      "start": 634.26,
      "end": 636.26,
      "text": "それから話を聞いて"
    },
    {
      "start": 637.26,
      "end": 641.26,
      "text": "問題用紙の1から4の中から"
    },
    {
      "start": 642.26,
      "end": 646.26,
      "text": "最もよいものを1つ選んでください"
    },
    {
      "start": 648.26,
      "end": 651.26,
      "text": "では、始めます"
    },
    {
      "start": 657.26,
      "end": 658.26,
      "text": "一番"
    },
    {
      "start": 672.26,
      "end": 675.26,
      "text": "一番"
    },
    {
      "start": 694.26,
      "end": 700.26,
      "text": "かとさん、最近順曜で地獄や決斥することがあるみたいだけど"
    },
    {
      "start": 700.26,
      "end": 703.26,
      "text": "レポートもウェダさんに出してもらったみたいだし"
    },
    {
      "start": 703.26,
      "end": 707.26,
      "text": "はい、でもレポートはしっかり自分で書きました"
    },
    {
      "start": 707.26,
      "end": 711.26,
      "text": "私の心配はレポートのことじゃなくてね"
    },
    {
      "start": 711.26,
      "end": 712.26,
      "text": "はい"
    },
    {
      "start": 712.26,
      "end": 714.26,
      "text": "ちょっと急がしすぎるんじゃない?"
    },
    {
      "start": 714.26,
      "end": 718.26,
      "text": "ウェダさんからはアルバイトの制だって聞いてるけど"
    },
    {
      "start": 718.26,
      "end": 720.26,
      "text": "ああ、はい"
    },
    {
      "start": 720.26,
      "end": 722.26,
      "text": "実はそうなんです"
    },
    {
      "start": 722.26,
      "end": 725.26,
      "text": "先日の小学金の試験落ちてしまったので"
    },
    {
      "start": 725.26,
      "end": 727.26,
      "text": "そう"
    },
    {
      "start": 727.26,
      "end": 731.26,
      "text": "でも体を壊したら大変だから無理しないように"
    },
    {
      "start": 731.26,
      "end": 733.26,
      "text": "わかりました"
    },
    {
      "start": 737.26,
      "end": 744.26,
      "text": "事務所の人はこの学生のことでどんなことを心配していますか"
    },
    {
      "start": 757.26,
      "end": 760.26,
      "text": "2番"
    },
    {
      "start": 788.26,
      "end": 792.26,
      "text": "今、日本では海外からの観光客が増えています"
    },
    {
      "start": 792.26,
      "end": 805.26,
      "text": "外国語のパンフレットを置いている観光地も多いですよね"
    },
    {
      "start": 805.26,
      "end": 810.26,
      "text": "今日は外国の方に人気の赤い流感に来ています"
    },
    {
      "start": 810.26,
      "end": 814.26,
      "text": "最近では外国の方が止まりやすいよ"
    },
    {
      "start": 814.26,
      "end": 818.26,
      "text": "部屋を用意してベッドを置くところがある一方"
    },
    {
      "start": 818.26,
      "end": 822.26,
      "text": "こちらでは去年全ての部屋をたたみにしました"
    },
    {
      "start": 822.26,
      "end": 829.26,
      "text": "すると日本文化に興味を持つ外国の方が多くお客さんが増加しました"
    },
    {
      "start": 829.26,
      "end": 834.26,
      "text": "今後は日本料理の教室も開かれるそうです"
    },
    {
      "start": 835.26,
      "end": 848.26,
      "text": "この両関で外国からのお客さんが増えたのはどうしてだと言っていますか"
    },
    {
      "start": 849.26,
      "end": 852.26,
      "text": "3番"
    },
    {
      "start": 862.26,
      "end": 867.26,
      "text": "なじおで女の人が話しています"
    },
    {
      "start": 867.26,
      "end": 873.26,
      "text": "女の人は生ごみの匂いを防ぐためにどうしていますか"
    },
    {
      "start": 879.26,
      "end": 882.26,
      "text": "2番"
    },
    {
      "start": 882.26,
      "end": 885.26,
      "text": "2番"
    },
    {
      "start": 885.26,
      "end": 889.26,
      "text": "2番"
    },
    {
      "start": 889.26,
      "end": 892.26,
      "text": "2番"
    },
    {
      "start": 892.26,
      "end": 895.26,
      "text": "2番"
    },
    {
      "start": 895.26,
      "end": 897.26,
      "text": "2番"
    },
    {
      "start": 897.26,
      "end": 901.26,
      "text": "料理の時や食事の残りで出る生ごみ"
    },
    {
      "start": 901.26,
      "end": 904.26,
      "text": "夏は匂いが気になりますね"
    },
    {
      "start": 904.26,
      "end": 909.26,
      "text": "匂いを防ぐには生ごみをよく乾かす、凍らせる"
    },
    {
      "start": 909.26,
      "end": 914.26,
      "text": "超ミリオのスをかけて匂いを消すなどの方法があります"
    },
    {
      "start": 914.26,
      "end": 918.26,
      "text": "私はすのすっぱい匂いが苦手だし"
    },
    {
      "start": 918.26,
      "end": 923.26,
      "text": "生ごみを食べ物と一緒に冷凍庫に入れるのはちょっとと思ってしまうので"
    },
    {
      "start": 923.26,
      "end": 928.26,
      "text": "新聞市に移すんでベランダで乾かすようにしています"
    },
    {
      "start": 928.26,
      "end": 933.26,
      "text": "家に匂いがあれば匂いを埋めてしまうというのが簡単だし"
    },
    {
      "start": 933.26,
      "end": 936.26,
      "text": "リサイクルにもなっていいんですが"
    },
    {
      "start": 936.26,
      "end": 942.26,
      "text": "私のようにアパートに住んでるとそれは無理ですからね"
    },
    {
      "start": 948.26,
      "end": 954.26,
      "text": "女の人は生ごみの匂いを防ぐためにどうしていますか"
    },
    {
      "start": 964.26,
      "end": 968.26,
      "text": "4番"
    },
    {
      "start": 968.26,
      "end": 975.26,
      "text": "ラジオでアナウンサーとサッカの男の人が話しています"
    },
    {
      "start": 975.26,
      "end": 983.26,
      "text": "男の人が最近山に登っている一番の目的は何ですか"
    },
    {
      "start": 993.26,
      "end": 997.26,
      "text": "3番"
    },
    {
      "start": 997.26,
      "end": 1001.26,
      "text": "3番"
    },
    {
      "start": 1001.26,
      "end": 1005.26,
      "text": "3番"
    },
    {
      "start": 1005.26,
      "end": 1008.26,
      "text": "皆さんこんにちは"
    },
    {
      "start": 1008.26,
      "end": 1014.26,
      "text": "今日お話してくださるのはサッカの山本大好きさんです"
    },
    {
      "start": 1014.26,
      "end": 1016.26,
      "text": "さっそくですが山本さん"
    },
    {
      "start": 1016.26,
      "end": 1019.26,
      "text": "9日はどのように過ごしていらっしゃるんですか"
    },
    {
      "start": 1019.26,
      "end": 1024.26,
      "text": "最近はよく息子と山に登りますね"
    },
    {
      "start": 1024.26,
      "end": 1026.26,
      "text": "山に"
    },
    {
      "start": 1026.26,
      "end": 1031.26,
      "text": "以前から一人で山にはよく登っていたんですよ"
    },
    {
      "start": 1031.26,
      "end": 1037.26,
      "text": "花を観察したりしながら一人で山道を歩いていると諦まなくて"
    },
    {
      "start": 1037.26,
      "end": 1042.26,
      "text": "自然の中にいると小説のアイデアがどんどん相手きましてね"
    },
    {
      "start": 1042.26,
      "end": 1044.26,
      "text": "なるほど"
    },
    {
      "start": 1044.26,
      "end": 1051.26,
      "text": "でも半年ぐらい前に最後まで諦めないで山に登るという経験を繰り返すことが"
    },
    {
      "start": 1051.26,
      "end": 1054.26,
      "text": "子供の教育にいいということを聞きましてね"
    },
    {
      "start": 1054.26,
      "end": 1058.26,
      "text": "それで息子を誘ってみたんです"
    },
    {
      "start": 1058.26,
      "end": 1063.26,
      "text": "前から何か自身になるような経験を与えてやりたいと思っていたので"
    },
    {
      "start": 1063.26,
      "end": 1067.26,
      "text": "今では山に行くときはいつも一緒です"
    },
    {
      "start": 1067.26,
      "end": 1071.26,
      "text": "私が山に登る目的は変わりましたが"
    },
    {
      "start": 1071.26,
      "end": 1074.26,
      "text": "やっぱり山はいいなぁと思います"
    },
    {
      "start": 1074.26,
      "end": 1077.26,
      "text": "うちに帰って山の話をしていると"
    },
    {
      "start": 1077.26,
      "end": 1079.26,
      "text": "つまも入ってきたね"
    },
    {
      "start": 1079.26,
      "end": 1083.26,
      "text": "以前より家族の会話も増えたような気がしますよ"
    },
    {
      "start": 1088.26,
      "end": 1095.26,
      "text": "男の人が最近山に登っている一番の目的は何ですか"
    },
    {
      "start": 1102.26,
      "end": 1104.26,
      "text": "5番"
    },
    {
      "start": 1104.26,
      "end": 1108.26,
      "text": "電話でおっととつまだ話しています"
    },
    {
      "start": 1108.26,
      "end": 1120.26,
      "text": "2人は今日の番ご飯をどうしますか"
    },
    {
      "start": 1132.26,
      "end": 1135.26,
      "text": "3番"
    },
    {
      "start": 1135.26,
      "end": 1139.26,
      "text": "4番"
    },
    {
      "start": 1139.26,
      "end": 1143.26,
      "text": "4番"
    },
    {
      "start": 1143.26,
      "end": 1148.26,
      "text": "もしもし今日仕事早く終わるから外で夕飯食べない"
    },
    {
      "start": 1148.26,
      "end": 1152.26,
      "text": "近所に新しくできたレストランピザがおいしいらしいって言ってただろ"
    },
    {
      "start": 1152.26,
      "end": 1154.26,
      "text": "行ってみようよ"
    },
    {
      "start": 1154.26,
      "end": 1159.26,
      "text": "うんピザはいいんだけど気におびだし込んでるんじゃない"
    },
    {
      "start": 1159.26,
      "end": 1162.26,
      "text": "それに今日はうちでゆっくりしたい気分"
    },
    {
      "start": 1162.26,
      "end": 1163.26,
      "text": "そっか"
    },
    {
      "start": 1163.26,
      "end": 1167.26,
      "text": "なんかピザが食べたくなっちゃったからうちで一緒に作ろうよ"
    },
    {
      "start": 1167.26,
      "end": 1170.26,
      "text": "ピザって作るの難しくない?"
    },
    {
      "start": 1170.26,
      "end": 1173.26,
      "text": "材料も買いに行かなけれけないし"
    },
    {
      "start": 1173.26,
      "end": 1177.26,
      "text": "めんどくさいからどこかピザやに注文して配達してもらおうよ"
    },
    {
      "start": 1177.26,
      "end": 1178.26,
      "text": "わかった"
    },
    {
      "start": 1178.26,
      "end": 1180.26,
      "text": "じゃあ注文したいてね"
    },
    {
      "start": 1180.26,
      "end": 1182.26,
      "text": "あ、ちょっと待って"
    },
    {
      "start": 1182.26,
      "end": 1186.26,
      "text": "確かあの新しいレストランも近いりもできるはず"
    },
    {
      "start": 1186.26,
      "end": 1191.26,
      "text": "帰りにとりに寄ってくれるなら私注文してくけどどう?"
    },
    {
      "start": 1191.26,
      "end": 1194.26,
      "text": "うん、とりに行くのはいいんだけど"
    },
    {
      "start": 1194.26,
      "end": 1196.26,
      "text": "せっかく新しくできたレストランだし"
    },
    {
      "start": 1196.26,
      "end": 1198.26,
      "text": "それなら店で食べない?"
    },
    {
      "start": 1198.26,
      "end": 1203.26,
      "text": "まずはうちで食べてみておいしかったら次食べに行こうよ"
    },
    {
      "start": 1203.26,
      "end": 1205.26,
      "text": "うん、わかった"
    },
    {
      "start": 1206.26,
      "end": 1207.26,
      "text": "2"
    },
    {
      "start": 1207.26,
      "end": 1209.26,
      "text": "2"
    },
    {
      "start": 1209.26,
      "end": 1211.26,
      "text": "2"
    },
    {
      "start": 1211.26,
      "end": 1212.26,
      "text": "2"
    },
    {
      "start": 1212.26,
      "end": 1216.26,
      "text": "りは今日の番号版をどうしますか?"
    },
    {
      "start": 1226.26,
      "end": 1229.26,
      "text": "6番"
    },
    {
      "start": 1229.26,
      "end": 1234.26,
      "text": "会社で女のシャインと家庁が話しています"
    },
    {
      "start": 1236.26,
      "end": 1242.26,
      "text": "家庁はどうして朝日電気のプリンターを買うことにしましたか?"
    },
    {
      "start": 1243.26,
      "end": 1244.26,
      "text": "2"
    },
    {
      "start": 1244.26,
      "end": 1248.26,
      "text": "りは今日の番号版を買うことにしましたか?"
    },
    {
      "start": 1248.26,
      "end": 1249.26,
      "text": "1"
    },
    {
      "start": 1249.26,
      "end": 1254.26,
      "text": "りは今日の番号版を買うことにしましたか?"
    },
    {
      "start": 1254.26,
      "end": 1256.26,
      "text": "2"
    },
    {
      "start": 1256.26,
      "end": 1261.26,
      "text": "りは今日の番号版を買うことにしましたか?"
    },
    {
      "start": 1261.26,
      "end": 1262.26,
      "text": "2"
    },
    {
      "start": 1262.26,
      "end": 1264.26,
      "text": "りは今日の番号版を買うことにしましたか?"
    },
    {
      "start": 1264.26,
      "end": 1269.26,
      "text": "家庁、英語部で新しく買うプリンターのことなんですが"
    },
    {
      "start": 1269.26,
      "end": 1270.26,
      "text": "うん"
    },
    {
      "start": 1270.26,
      "end": 1278.26,
      "text": "川田電気と朝日電気の製品にいいのが一大ずつありましたのでどちらか選んでください"
    },
    {
      "start": 1278.26,
      "end": 1279.26,
      "text": "うん"
    },
    {
      "start": 1279.26,
      "end": 1283.26,
      "text": "どっちも前のプリンターを置いてたとこにおけるサイズなんだよね"
    },
    {
      "start": 1283.26,
      "end": 1286.26,
      "text": "はい、どちらも大丈夫です"
    },
    {
      "start": 1286.26,
      "end": 1292.26,
      "text": "川田のは前のプリンターより小さいので他の場所にもおけると思います"
    },
    {
      "start": 1292.26,
      "end": 1296.26,
      "text": "朝日の方は川田のより人周り大きいんですけど"
    },
    {
      "start": 1296.26,
      "end": 1299.26,
      "text": "きれいに印刷できるのが特徴です"
    },
    {
      "start": 1299.26,
      "end": 1303.26,
      "text": "その代わり、インク台は少し高くなりそうですが"
    },
    {
      "start": 1303.26,
      "end": 1308.26,
      "text": "インク台が少しぐらい高くても印刷がきれいなのにしよう"
    },
    {
      "start": 1308.26,
      "end": 1309.26,
      "text": "朝日の方"
    },
    {
      "start": 1309.26,
      "end": 1313.26,
      "text": "あ、一度に入れておける髪の量はどうなの?"
    },
    {
      "start": 1313.26,
      "end": 1317.26,
      "text": "どちらも前のプリンターと同じぐらいです"
    },
    {
      "start": 1317.26,
      "end": 1320.26,
      "text": "じゃああまりたくさんは入らないんだね"
    },
    {
      "start": 1320.26,
      "end": 1323.26,
      "text": "もっと入る方が実用的だと思ってたけど"
    },
    {
      "start": 1323.26,
      "end": 1326.26,
      "text": "そういうのはサイズも大きくなっちゃうんだろうな"
    },
    {
      "start": 1326.26,
      "end": 1328.26,
      "text": "じゃあ朝日の頼みよう"
    },
    {
      "start": 1328.26,
      "end": 1330.26,
      "text": "はい"
    },
    {
      "start": 1335.26,
      "end": 1340.26,
      "text": "家庁はどうして朝日電気のプリンターを買うことにしましたか?"
    },
    {
      "start": 1353.26,
      "end": 1356.26,
      "text": "ここでちょっと休みましょう"
    },
    {
      "start": 1389.26,
      "end": 1392.26,
      "text": "ではまた続けます"
    },
    {
      "start": 1398.26,
      "end": 1400.26,
      "text": "問題3"
    },
    {
      "start": 1400.26,
      "end": 1402.26,
      "text": "問題3では"
    },
    {
      "start": 1402.26,
      "end": 1407.26,
      "text": "問題用紙に何も印刷されていません"
    },
    {
      "start": 1408.26,
      "end": 1415.26,
      "text": "この問題は全体としてどんな内容化を聞く問題です"
    },
    {
      "start": 1416.26,
      "end": 1421.26,
      "text": "話の前に質問はありません"
    },
    {
      "start": 1421.26,
      "end": 1425.26,
      "text": "まず話を聞いてください"
    },
    {
      "start": 1425.26,
      "end": 1430.26,
      "text": "それから質問と選択肢を聞いて"
    },
    {
      "start": 1430.26,
      "end": 1433.26,
      "text": "1から4の中から"
    },
    {
      "start": 1433.26,
      "end": 1439.26,
      "text": "もっともよいものを一つ選んでください"
    },
    {
      "start": 1439.26,
      "end": 1443.26,
      "text": "では始めます"
    },
    {
      "start": 1446.26,
      "end": 1449.26,
      "text": "1番"
    },
    {
      "start": 1449.26,
      "end": 1454.26,
      "text": "男の人と女の人が話しています"
    },
    {
      "start": 1454.26,
      "end": 1458.26,
      "text": "最近マラソンを始めたんだって"
    },
    {
      "start": 1458.26,
      "end": 1461.26,
      "text": "1ヶ月くらい前から練習してる"
    },
    {
      "start": 1461.26,
      "end": 1464.26,
      "text": "やっぱり健康のため"
    },
    {
      "start": 1464.26,
      "end": 1467.26,
      "text": "確かに体にはいいと思うけど"
    },
    {
      "start": 1467.26,
      "end": 1470.26,
      "text": "本当は長く走るの苦手だったんだ"
    },
    {
      "start": 1471.26,
      "end": 1473.26,
      "text": "じゃあどうして"
    },
    {
      "start": 1473.26,
      "end": 1476.26,
      "text": "会社の先輩にマラソンが好きな人がいて"
    },
    {
      "start": 1476.26,
      "end": 1479.26,
      "text": "一緒に大会に出ようって誘われて"
    },
    {
      "start": 1479.26,
      "end": 1481.26,
      "text": "話を聞いていたら"
    },
    {
      "start": 1481.26,
      "end": 1484.26,
      "text": "やってみてもいいかなって思ったんだ"
    },
    {
      "start": 1484.26,
      "end": 1485.26,
      "text": "そうなんだ"
    },
    {
      "start": 1485.26,
      "end": 1488.26,
      "text": "大会、内容なんだけど"
    },
    {
      "start": 1488.26,
      "end": 1490.26,
      "text": "ゆっくりでもゴールできたらいいな"
    },
    {
      "start": 1490.26,
      "end": 1492.26,
      "text": "頑張ったね"
    },
    {
      "start": 1493.26,
      "end": 1502.26,
      "text": "女の人は何について話していますか"
    },
    {
      "start": 1502.26,
      "end": 1508.26,
      "text": "1.マラソンの練習方法"
    },
    {
      "start": 1508.26,
      "end": 1515.26,
      "text": "2.マラソンによる体の変化"
    },
    {
      "start": 1515.26,
      "end": 1521.26,
      "text": "3.マラソンを始めた理由"
    },
    {
      "start": 1522.26,
      "end": 1529.26,
      "text": "4.マラソン体会の結果"
    },
    {
      "start": 1540.26,
      "end": 1542.26,
      "text": "2番"
    },
    {
      "start": 1542.26,
      "end": 1548.26,
      "text": "会社で男の人と女の人が話しています"
    },
    {
      "start": 1548.26,
      "end": 1553.26,
      "text": "あの家庁、来週の会議のことでお話があるんですが"
    },
    {
      "start": 1553.26,
      "end": 1556.26,
      "text": "あ、山田さん、どうしたの?"
    },
    {
      "start": 1556.26,
      "end": 1560.26,
      "text": "実は腕が痛くて機能病院へ行ったんですが"
    },
    {
      "start": 1560.26,
      "end": 1563.26,
      "text": "一応検査をすることになりまして"
    },
    {
      "start": 1563.26,
      "end": 1567.26,
      "text": "あの、それで検査の日が選べなくて"
    },
    {
      "start": 1567.26,
      "end": 1570.26,
      "text": "来週の会議の人がさなってしまったんです"
    },
    {
      "start": 1570.26,
      "end": 1573.26,
      "text": "検査は1時に終わる予定なんですが"
    },
    {
      "start": 1573.26,
      "end": 1576.26,
      "text": "1時半からの会議にはちょっと"
    },
    {
      "start": 1577.26,
      "end": 1582.26,
      "text": "会議の最後の方でこの間の出張の報告をすることになっているんですが"
    },
    {
      "start": 1582.26,
      "end": 1584.26,
      "text": "それまでには間に合うと思います"
    },
    {
      "start": 1584.26,
      "end": 1587.26,
      "text": "わかりました、大丈夫だといいですね"
    },
    {
      "start": 1587.26,
      "end": 1590.26,
      "text": "もし検査に時間がかかって"
    },
    {
      "start": 1590.26,
      "end": 1592.26,
      "text": "結石することになりそうだったら"
    },
    {
      "start": 1592.26,
      "end": 1595.26,
      "text": "連絡してください"
    },
    {
      "start": 1599.26,
      "end": 1604.26,
      "text": "男の人が会議について言いたいことは何ですか"
    },
    {
      "start": 1605.26,
      "end": 1609.26,
      "text": "1、遅れて出席する"
    },
    {
      "start": 1611.26,
      "end": 1615.26,
      "text": "2、出席できない"
    },
    {
      "start": 1616.26,
      "end": 1621.26,
      "text": "3、時間を変えてほしい"
    },
    {
      "start": 1622.26,
      "end": 1628.26,
      "text": "4、進行の順番を変えてほしい"
    },
    {
      "start": 1635.26,
      "end": 1639.26,
      "text": "3、間に合う"
    },
    {
      "start": 1641.26,
      "end": 1643.26,
      "text": "3番"
    },
    {
      "start": 1643.26,
      "end": 1648.26,
      "text": "テレビで女の人が話しています"
    },
    {
      "start": 1648.26,
      "end": 1651.26,
      "text": "皆さんは歩いている時に"
    },
    {
      "start": 1651.26,
      "end": 1655.26,
      "text": "膝や腰に痛みを感じることはありませんか"
    },
    {
      "start": 1655.26,
      "end": 1659.26,
      "text": "痛みの原因は年齢によるものもありますが"
    },
    {
      "start": 1659.26,
      "end": 1663.26,
      "text": "歩き方を変えることでよくなることもあるんですよ"
    },
    {
      "start": 1664.26,
      "end": 1668.26,
      "text": "普段自分がどのように歩いているか"
    },
    {
      "start": 1668.26,
      "end": 1671.26,
      "text": "意識している人は少ないかもしれませんが"
    },
    {
      "start": 1671.26,
      "end": 1674.26,
      "text": "歩く姿勢に気をつけるだけで"
    },
    {
      "start": 1674.26,
      "end": 1677.26,
      "text": "痛みが軽くなることがあります"
    },
    {
      "start": 1677.26,
      "end": 1680.26,
      "text": "自分にあった靴を選ぶことも大事ですが"
    },
    {
      "start": 1680.26,
      "end": 1684.26,
      "text": "普段の歩き方にも注意してみましょう"
    },
    {
      "start": 1685.26,
      "end": 1689.26,
      "text": "女の人は何について話していますか"
    },
    {
      "start": 1689.26,
      "end": 1694.26,
      "text": "1、美しく見える歩き方"
    },
    {
      "start": 1694.26,
      "end": 1699.26,
      "text": "2、靴の正しい選び方"
    },
    {
      "start": 1699.26,
      "end": 1704.26,
      "text": "3、足の痛みと年齢の関係"
    },
    {
      "start": 1704.26,
      "end": 1710.26,
      "text": "4、体の痛みと歩く姿勢の関係"
    },
    {
      "start": 1734.26,
      "end": 1741.14,
      "text": "問題4では、絵を見ながら質問を聞いてください。"
    },
    {
      "start": 1741.14,
      "end": 1746.26,
      "text": "矢印の人は、なんと言いますか?"
    },
    {
      "start": 1746.26,
      "end": 1755.26,
      "text": "1から3の中から、最も良いものを、一つ選んでください。"
    },
    {
      "start": 1755.26,
      "end": 1760.26,
      "text": "では、始めます。"
    },
    {
      "start": 1764.26,
      "end": 1768.98,
      "text": "1番、中社上がとても混んでいます。"
    },
    {
      "start": 1768.98,
      "end": 1772.9,
      "text": "車が止められるかどうかわかりません。"
    },
    {
      "start": 1772.9,
      "end": 1777.26,
      "text": "かかりの人に、なんと言いますか?"
    },
    {
      "start": 1777.26,
      "end": 1783.66,
      "text": "1、あのー、相手いるところありませんか?"
    },
    {
      "start": 1783.66,
      "end": 1790.5,
      "text": "2、あのー、ここに車を置くことにしませんか?"
    },
    {
      "start": 1790.5,
      "end": 1799.5,
      "text": "3、あのー、ちょっと止まってもらえませんか?"
    },
    {
      "start": 1799.5,
      "end": 1815.02,
      "text": "2番、友達のうちに、見たことがないゲームがあります。"
    },
    {
      "start": 1815.02,
      "end": 1821.02,
      "text": "今、かりてやりたいです。なんと言いますか?"
    },
    {
      "start": 1821.02,
      "end": 1826.74,
      "text": "1、ねー、これもらいたいんだけど。"
    },
    {
      "start": 1826.74,
      "end": 1832.22,
      "text": "2、ねー、ゲームやるんじゃない?"
    },
    {
      "start": 1832.22,
      "end": 1838.22,
      "text": "3、ねー、このゲームやってみたい。"
    },
    {
      "start": 1845.02,
      "end": 1856.02,
      "text": "3番、コンビニの機械で、コンサートのチケットを予約します。"
    },
    {
      "start": 1856.02,
      "end": 1859.02,
      "text": "使い方がわかりません。"
    },
    {
      "start": 1859.02,
      "end": 1863.02,
      "text": "店員に、なんと言いますか?"
    },
    {
      "start": 1863.02,
      "end": 1869.02,
      "text": "1、どうやって予約するのか、お知れましょうか?"
    },
    {
      "start": 1869.02,
      "end": 1874.02,
      "text": "2、予約はどうすればいいんですか?"
    },
    {
      "start": 1875.02,
      "end": 1881.02,
      "text": "3、チケットを予約したらどうでしょうか?"
    },
    {
      "start": 1893.02,
      "end": 1901.02,
      "text": "4番、昨日、順行をやすんだので、友達のうとコピーしたいです。"
    },
    {
      "start": 1901.02,
      "end": 1904.02,
      "text": "なんと言いますか?"
    },
    {
      "start": 1904.02,
      "end": 1911.02,
      "text": "1、悪いんだけど、昨日ののおとコピーさせて。"
    },
    {
      "start": 1911.02,
      "end": 1918.02,
      "text": "2、あのー、実はのおとコピーするんだって。"
    },
    {
      "start": 1918.02,
      "end": 1925.02,
      "text": "3、ねー、こののおとコピーしたかったらいいよ?"
    },
    {
      "start": 1932.02,
      "end": 1935.02,
      "text": "3、ヨーラー"
    },
    {
      "start": 1938.02,
      "end": 1949.02,
      "text": "問題5、問題5では、問題養士に何も飲食されていません。"
    },
    {
      "start": 1949.02,
      "end": 1953.02,
      "text": "まず、文を聞いてください。"
    },
    {
      "start": 1953.02,
      "end": 1957.02,
      "text": "それから、その辺時を聞いて、"
    },
    {
      "start": 1957.02,
      "end": 1966.02,
      "text": "1から3の中から、最も良いものを、一つ選んでください。"
    },
    {
      "start": 1968.02,
      "end": 1971.02,
      "text": "では、始めます。"
    },
    {
      "start": 1976.02,
      "end": 1978.02,
      "text": "1番。"
    },
    {
      "start": 1978.02,
      "end": 1982.02,
      "text": "はい、昼ご飯できたよ。さめないうちに食べて。"
    },
    {
      "start": 1983.02,
      "end": 1984.02,
      "text": "1。"
    },
    {
      "start": 1984.02,
      "end": 1987.02,
      "text": "わー、本当に冷たさ。"
    },
    {
      "start": 1988.02,
      "end": 1989.02,
      "text": "2。"
    },
    {
      "start": 1989.02,
      "end": 1992.02,
      "text": "じゃあ、早速いただくね。"
    },
    {
      "start": 1993.02,
      "end": 1994.02,
      "text": "3。"
    },
    {
      "start": 1995.02,
      "end": 1998.02,
      "text": "えぇ、まだ食べちゃダメ。"
    },
    {
      "start": 2008.02,
      "end": 2010.02,
      "text": "2番。"
    },
    {
      "start": 2010.02,
      "end": 2015.02,
      "text": "山田君をおそいね、電話した方がいいんじゃない?"
    },
    {
      "start": 2016.02,
      "end": 2017.02,
      "text": "1。"
    },
    {
      "start": 2017.02,
      "end": 2020.02,
      "text": "うん、そうしようか。"
    },
    {
      "start": 2021.02,
      "end": 2022.02,
      "text": "2。"
    },
    {
      "start": 2022.02,
      "end": 2025.02,
      "text": "それは良くなかったね。"
    },
    {
      "start": 2026.02,
      "end": 2027.02,
      "text": "3。"
    },
    {
      "start": 2027.02,
      "end": 2030.02,
      "text": "早く来た方がいいよ。"
    },
    {
      "start": 2041.02,
      "end": 2042.02,
      "text": "3番。"
    },
    {
      "start": 2042.02,
      "end": 2045.02,
      "text": "森田さん、風はどうですか?"
    },
    {
      "start": 2045.02,
      "end": 2047.02,
      "text": "調子は戻りましたか?"
    },
    {
      "start": 2049.02,
      "end": 2050.02,
      "text": "1。"
    },
    {
      "start": 2050.02,
      "end": 2052.02,
      "text": "もう戻ることにしました。"
    },
    {
      "start": 2054.02,
      "end": 2055.02,
      "text": "2。"
    },
    {
      "start": 2055.02,
      "end": 2057.02,
      "text": "元気になるといいですね。"
    },
    {
      "start": 2059.02,
      "end": 2060.02,
      "text": "3。"
    },
    {
      "start": 2060.02,
      "end": 2062.02,
      "text": "おかげ様で、もうすっかり。"
    },
    {
      "start": 2071.02,
      "end": 2074.02,
      "text": "4番。"
    },
    {
      "start": 2074.02,
      "end": 2079.02,
      "text": "服を買いに行きたいんだけど、今日一緒に行ってくれない?"
    },
    {
      "start": 2080.02,
      "end": 2081.02,
      "text": "1。"
    },
    {
      "start": 2081.02,
      "end": 2084.02,
      "text": "今、あまり欲しくないな。"
    },
    {
      "start": 2086.02,
      "end": 2087.02,
      "text": "2。"
    },
    {
      "start": 2087.02,
      "end": 2090.02,
      "text": "明日なら暇なんだけど。"
    },
    {
      "start": 2091.02,
      "end": 2092.02,
      "text": "3。"
    },
    {
      "start": 2093.02,
      "end": 2095.02,
      "text": "一緒に行ってもらったらどう?"
    },
    {
      "start": 2101.02,
      "end": 2102.02,
      "text": "5番。"
    },
    {
      "start": 2102.02,
      "end": 2106.02,
      "text": "佐藤さん、昨日の会議の報告、書き終わった?"
    },
    {
      "start": 2107.02,
      "end": 2109.02,
      "text": "1。"
    },
    {
      "start": 2109.02,
      "end": 2112.02,
      "text": "報告、やっと完成したんですか?"
    },
    {
      "start": 2113.02,
      "end": 2115.02,
      "text": "2。"
    },
    {
      "start": 2115.02,
      "end": 2118.02,
      "text": "あ、できたので、見ていただけますか?"
    },
    {
      "start": 2119.02,
      "end": 2121.02,
      "text": "3。"
    },
    {
      "start": 2122.02,
      "end": 2125.02,
      "text": "会議なら、もう終わったみたいです。"
    },
    {
      "start": 2125.02,
      "end": 2127.02,
      "text": "3。"
    },
    {
      "start": 2128.02,
      "end": 2131.02,
      "text": "会議なら、もう終わったみたいですよ。"
    },
    {
      "start": 2142.02,
      "end": 2143.02,
      "text": "6番。"
    },
    {
      "start": 2143.02,
      "end": 2148.02,
      "text": "先輩、田中さんに会いたいんですが、連絡先をご存じですか?"
    },
    {
      "start": 2150.02,
      "end": 2151.02,
      "text": "1。"
    },
    {
      "start": 2151.02,
      "end": 2153.02,
      "text": "いつ連絡とったの?"
    },
    {
      "start": 2154.02,
      "end": 2155.02,
      "text": "2。"
    },
    {
      "start": 2156.02,
      "end": 2158.02,
      "text": "メールアドレスでいい?"
    },
    {
      "start": 2159.02,
      "end": 2160.02,
      "text": "3。"
    },
    {
      "start": 2160.02,
      "end": 2162.02,
      "text": "あって聞いてみたら?"
    },
    {
      "start": 2173.02,
      "end": 2174.02,
      "text": "7番。"
    },
    {
      "start": 2174.02,
      "end": 2179.02,
      "text": "失礼ですが、こちらのお店の方でいらっしゃいますか?"
    },
    {
      "start": 2180.02,
      "end": 2181.02,
      "text": "1。"
    },
    {
      "start": 2182.02,
      "end": 2183.02,
      "text": "違いますけど。"
    },
    {
      "start": 2185.02,
      "end": 2186.02,
      "text": "2。"
    },
    {
      "start": 2186.02,
      "end": 2188.02,
      "text": "それはわかりません。"
    },
    {
      "start": 2190.02,
      "end": 2191.02,
      "text": "3。"
    },
    {
      "start": 2191.02,
      "end": 2193.02,
      "text": "私はよく来ています。"
    },
    {
      "start": 2204.02,
      "end": 2205.02,
      "text": "8番。"
    },
    {
      "start": 2206.02,
      "end": 2212.02,
      "text": "田中さん、部長にあんなこといって、部長が起こるのもあたり前だよ。"
    },
    {
      "start": 2213.02,
      "end": 2214.02,
      "text": "1。"
    },
    {
      "start": 2214.02,
      "end": 2217.02,
      "text": "つい、これから気をつけます。"
    },
    {
      "start": 2219.02,
      "end": 2220.02,
      "text": "2。"
    },
    {
      "start": 2220.02,
      "end": 2223.02,
      "text": "確かに、私も意外でした。"
    },
    {
      "start": 2224.02,
      "end": 2225.02,
      "text": "3。"
    },
    {
      "start": 2225.02,
      "end": 2228.02,
      "text": "部長は起こってないんですか?"
    },
    {
      "start": 2236.02,
      "end": 2238.02,
      "text": "9番。"
    },
    {
      "start": 2241.02,
      "end": 2246.02,
      "text": "あと1時間でパーティ始まるから、もう料理並べとこうか?"
    },
    {
      "start": 2247.02,
      "end": 2248.02,
      "text": "1。"
    },
    {
      "start": 2249.02,
      "end": 2251.02,
      "text": "え、もう並べてあるの?"
    },
    {
      "start": 2252.02,
      "end": 2253.02,
      "text": "2。"
    },
    {
      "start": 2254.02,
      "end": 2257.02,
      "text": "え、始まってからだと遅いよ。"
    },
    {
      "start": 2258.02,
      "end": 2259.02,
      "text": "3。"
    },
    {
      "start": 2260.02,
      "end": 2262.02,
      "text": "え、ちょっと早くない?"
    }
  ]
}