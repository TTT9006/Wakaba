{
  "source": "c:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N3\\n3\\n3\\7-2021\\Nghe bản chuẩn N3 T7-2021.mp3",
  "duration": 2160.3015,
  "segments": [
    {
      "start": 0.0,
      "end": 14.14,
      "text": "ちょうかい試験を始める前に 音を聞いてください"
    },
    {
      "start": 14.14,
      "end": 20.84,
      "text": "まだ問題用紙を開けないでください"
    },
    {
      "start": 20.84,
      "end": 28.44,
      "text": "音がよく聞こえない時は 手を上げてください"
    },
    {
      "start": 28.44,
      "end": 32.56,
      "text": "天気がいいから 散歩しましょう"
    },
    {
      "start": 32.56,
      "end": 36.52,
      "text": "天気がいいから 散歩しましょう"
    },
    {
      "start": 36.52,
      "end": 40.92,
      "text": "天気がいいから 散歩しましょう"
    },
    {
      "start": 40.92,
      "end": 46.32,
      "text": "天気がいいから 散歩しましょう"
    },
    {
      "start": 46.32,
      "end": 52.88,
      "text": "日本語能力試験 上海 エヌーサン"
    },
    {
      "start": 52.88,
      "end": 58.68,
      "text": "これから エヌーサンの 超海試験を始めます"
    },
    {
      "start": 58.68,
      "end": 66.6,
      "text": "目もとってもいいです 問題用紙を開けてください"
    },
    {
      "start": 66.6,
      "end": 74.28,
      "text": "問題用紙のページがない時は 手を上げてください"
    },
    {
      "start": 74.28,
      "end": 80.44,
      "text": "問題がよく見えない時も 手を上げてください"
    },
    {
      "start": 80.44,
      "end": 88.68,
      "text": "いつでもいいです"
    },
    {
      "start": 88.68,
      "end": 98.04,
      "text": "問題1 問題1では まず質問を聞いてください"
    },
    {
      "start": 98.04,
      "end": 106.56,
      "text": "それから話を聞いて 問題用紙の1から4の中から"
    },
    {
      "start": 106.56,
      "end": 114.04,
      "text": "最も良いものを1つ選んでください"
    },
    {
      "start": 114.04,
      "end": 117.76,
      "text": "では始めます"
    },
    {
      "start": 122.08,
      "end": 128.8,
      "text": "一番 会社で男の人と女の人が話しています"
    },
    {
      "start": 128.8,
      "end": 134.08,
      "text": "女の人はどうやってドアを開けますか"
    },
    {
      "start": 134.08,
      "end": 138.44,
      "text": "佐藤さん 今日からお仕事をお願いすることになりました"
    },
    {
      "start": 138.44,
      "end": 141.8,
      "text": "よろしくお願いします よろしくお願いします"
    },
    {
      "start": 141.8,
      "end": 147.58,
      "text": "まず部屋の入り方を説明します 部屋の出入り口には安全のために"
    },
    {
      "start": 147.58,
      "end": 151.76,
      "text": "鍵がかけてあり関係者以外は入れないようになってます"
    },
    {
      "start": 151.76,
      "end": 155.92,
      "text": "はい 私たち社員は安勝番号を押すか"
    },
    {
      "start": 155.92,
      "end": 159.48,
      "text": "人差し指で機械に触れてドアを開けるんですが"
    },
    {
      "start": 159.48,
      "end": 164.24,
      "text": "佐藤さんはアルバイトですので こちらのカードを使いください"
    },
    {
      "start": 164.24,
      "end": 168.92,
      "text": "このカードを機械に入れるとピット音がなってドアが開きますので"
    },
    {
      "start": 168.92,
      "end": 171.92,
      "text": "はい"
    },
    {
      "start": 171.92,
      "end": 180.44,
      "text": "女の人はどうやってドアを開けますか"
    },
    {
      "start": 189.48,
      "end": 200.52,
      "text": "2番 女の子とお父さんが大度頃で話しています"
    },
    {
      "start": 200.52,
      "end": 207.08,
      "text": "女の子は何を買いますか 今日の昼焼きそば"
    },
    {
      "start": 207.08,
      "end": 212.88,
      "text": "やったー 材料は全部あるかなと"
    },
    {
      "start": 212.88,
      "end": 217.76,
      "text": "ぶたにくそば人人 キャベツがない"
    },
    {
      "start": 217.76,
      "end": 222.92,
      "text": "買ってこようか これからノートを買いに行くところだから"
    },
    {
      "start": 222.92,
      "end": 227.32,
      "text": "じゃあ頼むかな あちょっと待って"
    },
    {
      "start": 227.32,
      "end": 231.68,
      "text": "ここに白菜があるからキャベツは変わなくてもいいよ"
    },
    {
      "start": 231.68,
      "end": 235.6,
      "text": "あそうだ 買い物に行くんだったらついでに"
    },
    {
      "start": 235.6,
      "end": 244.8,
      "text": "卵を頼んでもいいかな わかった"
    },
    {
      "start": 244.8,
      "end": 263.04,
      "text": "女の子は何を買いますか"
    },
    {
      "start": 263.04,
      "end": 274.16,
      "text": "おんなの学生と男の学生が話しています 男の学生は何を手伝いますか"
    },
    {
      "start": 274.16,
      "end": 280.44,
      "text": "今度の日曜日新しい本田なお買いに行こうと思ってて ちょっと手伝ってほしい"
    },
    {
      "start": 280.44,
      "end": 282.96,
      "text": "んだけど いいよ"
    },
    {
      "start": 282.96,
      "end": 288.52,
      "text": "悪いんだけど本田なお車に乗せて うちまで送ってもらえない"
    },
    {
      "start": 288.52,
      "end": 292.96,
      "text": "もう買うものは決まってるから 店であれこれ選ぶ必要はないんだ"
    },
    {
      "start": 292.96,
      "end": 296.28,
      "text": "けど でも本田な車に乗る"
    },
    {
      "start": 296.28,
      "end": 299.96,
      "text": "自分で組み立てるタイプだから 乗ると思うんだ"
    },
    {
      "start": 299.96,
      "end": 303.32,
      "text": "それならいいよ 組み立てるのも鉄だおか"
    },
    {
      "start": 303.32,
      "end": 308.72,
      "text": "ありがとうそれは大丈夫 そんなに難しくないみたいだから"
    },
    {
      "start": 308.72,
      "end": 313.8,
      "text": "組み立てた後ペン気を塗ったりして 自分だけの本田なお作りたいんだ"
    },
    {
      "start": 313.8,
      "end": 319.0,
      "text": "そっか じゃあ日曜日宜しくね"
    },
    {
      "start": 319.0,
      "end": 328.0,
      "text": "おとこの学生は何を手伝いますか"
    },
    {
      "start": 328.0,
      "end": 348.64,
      "text": "4番学校の健康診断で 観護師が話しています"
    },
    {
      "start": 348.64,
      "end": 355.84,
      "text": "健康診断を受ける人は この後まず何をしますか"
    },
    {
      "start": 356.84,
      "end": 365.12,
      "text": "このグループの人は集まりましたね 皆さん健康庁さんの案件と書いて"
    },
    {
      "start": 365.12,
      "end": 372.72,
      "text": "持ってきましたか はいでは慎重と体重を 測りますその前に靴下は"
    },
    {
      "start": 372.72,
      "end": 379.24,
      "text": "乗り出をいてください 次に決発を測って内華の申殺に進みます"
    },
    {
      "start": 379.24,
      "end": 385.24,
      "text": "がそこで石に健康庁さんの案件とを 出してください"
    },
    {
      "start": 385.24,
      "end": 396.44,
      "text": "案件とはそれまで自分で持っていてください"
    },
    {
      "start": 396.44,
      "end": 403.84,
      "text": "健康診断を受ける人は この後まず何をしますか"
    },
    {
      "start": 409.24,
      "end": 424.24,
      "text": "5番 会社で女の部長と男の人が話しています"
    },
    {
      "start": 424.24,
      "end": 430.24,
      "text": "男の人はこの後まず何をしますか"
    },
    {
      "start": 432.24,
      "end": 438.24,
      "text": "おはよう 今忙しいちょっと手伝ってほしいことがあるんだけど"
    },
    {
      "start": 438.24,
      "end": 443.24,
      "text": "はい部長 急ではるいけど午後の会議のこの資料"
    },
    {
      "start": 443.24,
      "end": 450.04,
      "text": "3ページ目の表をグラフに変えてくれない 資料は本田さんに作ってもらってたんだけど"
    },
    {
      "start": 450.04,
      "end": 457.44,
      "text": "今お客さんから電話があって本田さん お客さんのところに行かなくちゃいけなくなったんだって"
    },
    {
      "start": 457.44,
      "end": 464.64,
      "text": "あの部長 実は森家庁に主張の報告を午前中に出すように言われているんですが"
    },
    {
      "start": 464.64,
      "end": 472.64,
      "text": "そうじゃあ森家庁には私から事場を説明しておくからこっちの方を先にいい"
    },
    {
      "start": 472.64,
      "end": 475.64,
      "text": "わかりました ありがとう"
    },
    {
      "start": 482.64,
      "end": 487.64,
      "text": "男の人はこの後まず何をしますか"
    },
    {
      "start": 495.64,
      "end": 508.64,
      "text": "6番 電話で男の人と大学の係の人が話しています"
    },
    {
      "start": 508.64,
      "end": 518.64,
      "text": "男の人は大学の卒業生命の処理をもらうために この後何を送りますか"
    },
    {
      "start": 518.64,
      "end": 526.64,
      "text": "はいもしもし キムラです"
    },
    {
      "start": 526.64,
      "end": 536.64,
      "text": "桜大学学生家の早しと申します 先日卒業生命の処理の申し込みを有想でいただきましたが"
    },
    {
      "start": 536.64,
      "end": 540.64,
      "text": "その申し込み処理についてご連絡いたしました"
    },
    {
      "start": 540.64,
      "end": 547.64,
      "text": "あの実は足りないものがありまして もう少しみるようの200円分の切ってと"
    },
    {
      "start": 547.64,
      "end": 556.64,
      "text": "編審用の切っても送りましたけど いや料金は大丈夫です最近やり方が変わりまして"
    },
    {
      "start": 556.64,
      "end": 569.64,
      "text": "以前はこちらで編審用の冬を用意してたんですが 現在はそちらでご自宅の住所を書いた冬をその他の書類と一緒に送っていただくことになっております"
    },
    {
      "start": 569.64,
      "end": 578.64,
      "text": "そうですかはい分かりました 申し込みの用紙と勉強症のコピーは確認できてますので"
    },
    {
      "start": 578.64,
      "end": 584.64,
      "text": "それだけもう一度を送っていただけますか はいすぐ送ります"
    },
    {
      "start": 588.64,
      "end": 597.64,
      "text": "男の人は大学の卒業生命の処理をもらうために この後何を送りますか"
    },
    {
      "start": 599.64,
      "end": 621.64,
      "text": "本来の問題に 問題2ではまず質問を聞いてください"
    },
    {
      "start": 621.64,
      "end": 630.64,
      "text": "その後問題用紙を見てください 読む時間があります"
    },
    {
      "start": 630.64,
      "end": 644.64,
      "text": "それから話を聞いて 問題用紙の1から4の中から 最も良いものを1つ選んでください"
    },
    {
      "start": 645.64,
      "end": 649.64,
      "text": "では始めます"
    },
    {
      "start": 652.64,
      "end": 655.64,
      "text": "1番"
    },
    {
      "start": 655.64,
      "end": 666.64,
      "text": "うちで男の人と女の人が話しています 子供の誕生日の日に何をすることにしましたか"
    },
    {
      "start": 682.64,
      "end": 694.64,
      "text": "9月たくやの誕生日だね 今年で7歳になるね"
    },
    {
      "start": 694.64,
      "end": 699.64,
      "text": "誕生日どうする 去年は食事に行ったけど"
    },
    {
      "start": 699.64,
      "end": 705.64,
      "text": "あの子喜んでたね 今年は本が欲しいって言ってたよ"
    },
    {
      "start": 706.64,
      "end": 712.64,
      "text": "誕生日ちょうど日曜日を みんなで一緒にどこかでかけましょうよ"
    },
    {
      "start": 712.64,
      "end": 718.64,
      "text": "あ あの子 動物が好きでしょ 動物園がいいんじゃない"
    },
    {
      "start": 718.64,
      "end": 720.64,
      "text": "そうだね そうしよう"
    },
    {
      "start": 720.64,
      "end": 727.64,
      "text": "あ でもサッカーの試合を見に行くっていうのは サッカーついぶん上手になってきたからね"
    },
    {
      "start": 727.64,
      "end": 731.64,
      "text": "私 サッカーよくわからないから"
    },
    {
      "start": 731.64,
      "end": 736.64,
      "text": "そうだね 家族で楽しめるのがいいね"
    },
    {
      "start": 740.64,
      "end": 746.64,
      "text": "子供の誕生日の日に何をすることにしましたか"
    },
    {
      "start": 757.64,
      "end": 761.64,
      "text": "2番"
    },
    {
      "start": 788.64,
      "end": 792.64,
      "text": "おそくなってごめん"
    },
    {
      "start": 792.64,
      "end": 796.64,
      "text": "おそーい 映画もう始まったよ"
    },
    {
      "start": 796.64,
      "end": 798.64,
      "text": "まとねぼう?"
    },
    {
      "start": 798.64,
      "end": 803.64,
      "text": "違うよ 急行電車に乗ったら 次の駅までいっちゃって"
    },
    {
      "start": 803.64,
      "end": 806.64,
      "text": "今日はせっかく早く起きたのに"
    },
    {
      "start": 806.64,
      "end": 812.64,
      "text": "もう あんなに約束したのに 送れないでって"
    },
    {
      "start": 813.64,
      "end": 817.64,
      "text": "本当は映画見たくなかったんでしょう"
    },
    {
      "start": 817.64,
      "end": 822.64,
      "text": "そんなことないよ ごめん 本当にごめん"
    },
    {
      "start": 822.64,
      "end": 827.64,
      "text": "まー 約束忘れてもんかと思ったよ"
    },
    {
      "start": 832.64,
      "end": 836.64,
      "text": "男の人は どうして送れましたか"
    },
    {
      "start": 843.64,
      "end": 846.64,
      "text": "3番"
    },
    {
      "start": 846.64,
      "end": 851.64,
      "text": "道で 男の人と女の人が話しています"
    },
    {
      "start": 851.64,
      "end": 859.64,
      "text": "女の人が3歩を始めた理由は何ですか? 女の人です"
    },
    {
      "start": 873.64,
      "end": 876.64,
      "text": "おそい"
    },
    {
      "start": 889.64,
      "end": 894.64,
      "text": "あ 今度さんおはようございます サンポですか"
    },
    {
      "start": 894.64,
      "end": 897.64,
      "text": "えぇ 鈴木さんもですか?"
    },
    {
      "start": 897.64,
      "end": 902.64,
      "text": "はい 引っ越してきた時に 待ちのことを知りたくて始めました"
    },
    {
      "start": 902.64,
      "end": 905.64,
      "text": "今度さんは健康のためですか?"
    },
    {
      "start": 905.64,
      "end": 909.64,
      "text": "ああ 健康のためではないんですけど"
    },
    {
      "start": 909.64,
      "end": 914.64,
      "text": "えーっと 好きな歌手がこの街に住んでるって 噂を聞いて"
    },
    {
      "start": 914.64,
      "end": 918.64,
      "text": "会えるかもって期待して歩き始めたんです"
    },
    {
      "start": 918.64,
      "end": 922.64,
      "text": "ああ そうですか それで会えました"
    },
    {
      "start": 923.64,
      "end": 926.64,
      "text": "いいえ もう諦めました"
    },
    {
      "start": 926.64,
      "end": 931.64,
      "text": "でも 参考するようになってから 姿勢もよくなったし"
    },
    {
      "start": 931.64,
      "end": 935.64,
      "text": "花焼きを近くで見られて 季節を感じるようになりました"
    },
    {
      "start": 935.64,
      "end": 940.64,
      "text": "そうですか 確かに この辺りは緑が多くて"
    },
    {
      "start": 940.64,
      "end": 944.64,
      "text": "一年十花焼きが綺麗ですよね"
    },
    {
      "start": 945.64,
      "end": 953.64,
      "text": "女の人が サンポを始めた理由は何ですか?"
    },
    {
      "start": 967.64,
      "end": 969.64,
      "text": "4番"
    },
    {
      "start": 969.64,
      "end": 973.64,
      "text": "女の人がインタビューに答えています"
    },
    {
      "start": 973.64,
      "end": 980.64,
      "text": "女の人は この街の変化について どう思っていますか?"
    },
    {
      "start": 981.64,
      "end": 990.64,
      "text": "9番"
    },
    {
      "start": 1002.64,
      "end": 1008.14,
      "text": "子の辺り 私の子供の頃は 小さなお店しかなくて"
    },
    {
      "start": 1008.14,
      "end": 1010.78,
      "text": "人も少なかったんですよ。"
    },
    {
      "start": 1010.78,
      "end": 1016.22,
      "text": "でも、5年ほど前から、おしゃれな店が増えてね。"
    },
    {
      "start": 1016.22,
      "end": 1019.78,
      "text": "若い人がたくさん来るようになりました。"
    },
    {
      "start": 1019.78,
      "end": 1025.74,
      "text": "その分、昔からの店はどんどんなくなってしまって、"
    },
    {
      "start": 1025.74,
      "end": 1031.18,
      "text": "寂しがるとしよりもいますけど、私は良いと思うんですよ。"
    },
    {
      "start": 1031.18,
      "end": 1034.54,
      "text": "街に元気が出てきましたしね。"
    },
    {
      "start": 1034.54,
      "end": 1042.66,
      "text": "でも、私はおしゃれな店なんか、全然使わないんですけどね。"
    },
    {
      "start": 1046.66,
      "end": 1053.74,
      "text": "女の人は、この街の変化について、どう思っていますか?"
    },
    {
      "start": 1064.54,
      "end": 1068.54,
      "text": "5番"
    },
    {
      "start": 1095.54,
      "end": 1098.54,
      "text": "5番"
    },
    {
      "start": 1101.54,
      "end": 1105.02,
      "text": "異童さん、取りを買ってるんだってね。"
    },
    {
      "start": 1105.02,
      "end": 1108.02,
      "text": "犬が好きだって聞いたことはあったけど。"
    },
    {
      "start": 1108.02,
      "end": 1114.38,
      "text": "うん、私、出張が多いから、犬や猫は難しくって。"
    },
    {
      "start": 1114.38,
      "end": 1119.06,
      "text": "二三日ルスにしても大丈夫なペットが良かったんだ。"
    },
    {
      "start": 1119.06,
      "end": 1122.54,
      "text": "毎日三歩に連れていくのも大変だしね。"
    },
    {
      "start": 1122.54,
      "end": 1127.54,
      "text": "そう、取りなら、椅子と水を入れておけば大丈夫だよね。"
    },
    {
      "start": 1127.54,
      "end": 1129.1,
      "text": "三歩もいらないし。"
    },
    {
      "start": 1129.1,
      "end": 1131.86,
      "text": "そうなんだ、よく知ってるね。"
    },
    {
      "start": 1131.86,
      "end": 1136.86,
      "text": "僕も取りを買いたくて、色が綺麗だよね。"
    },
    {
      "start": 1136.86,
      "end": 1139.5,
      "text": "その取りは手に乗ったりするの?"
    },
    {
      "start": 1139.5,
      "end": 1146.34,
      "text": "手に乗ったりはしないんだけど、最近はコミュニケーションが取れるような気がする。"
    },
    {
      "start": 1146.34,
      "end": 1151.26,
      "text": "朝、かわいい恋で、挨拶みたいなのしてくれるようになったんだ。"
    },
    {
      "start": 1151.26,
      "end": 1153.26,
      "text": "え、いいね。"
    },
    {
      "start": 1158.26,
      "end": 1163.26,
      "text": "女の人が、ペットに取りを選んだ理由は何ですか?"
    },
    {
      "start": 1178.26,
      "end": 1179.26,
      "text": "六番"
    },
    {
      "start": 1180.26,
      "end": 1186.26,
      "text": "ラジオで、主張がマラソン大会について話しています。"
    },
    {
      "start": 1186.26,
      "end": 1194.26,
      "text": "主張はこの大会について、一番知ってもらいたいことは何だと言っていますか?"
    },
    {
      "start": 1210.26,
      "end": 1221.26,
      "text": "ライ月、南市ではマラソン大会が開かれます。"
    },
    {
      "start": 1221.26,
      "end": 1227.26,
      "text": "この大会は子供から大人まで参加でき、楽しく走ることができます。"
    },
    {
      "start": 1227.26,
      "end": 1231.26,
      "text": "また、たくさんの外国の方も参加しています。"
    },
    {
      "start": 1231.26,
      "end": 1240.26,
      "text": "外国の方は観光で訪問し大会に出る方もいますが、この街に住み生活している方がほとんどです。"
    },
    {
      "start": 1240.26,
      "end": 1253.26,
      "text": "この大会は、言葉や文化の壁を声、市民の皆さんが交流する機会にもなっていて、特にこの点を皆さんに伝えたいと思います。"
    },
    {
      "start": 1253.26,
      "end": 1262.26,
      "text": "これからも南市の方、国内、海外の観光客など多くの方に興味を持っていただきたいです。"
    },
    {
      "start": 1268.26,
      "end": 1274.26,
      "text": "主張はこの大会について、一番知ってもらいたいことは何だと言っていますか?"
    },
    {
      "start": 1283.26,
      "end": 1290.26,
      "text": "ここで、ちょっと安みましょう。"
    },
    {
      "start": 1314.26,
      "end": 1320.26,
      "text": "では、また続けます。"
    },
    {
      "start": 1331.26,
      "end": 1341.26,
      "text": "問題3。問題3では、問題用心に何も印刷されていません。"
    },
    {
      "start": 1341.26,
      "end": 1349.26,
      "text": "この問題は、全体としてどんな内容化を聞く問題です。"
    },
    {
      "start": 1350.26,
      "end": 1355.26,
      "text": "話の前に質問はありません。"
    },
    {
      "start": 1355.26,
      "end": 1359.26,
      "text": "まず話を聞いてください。"
    },
    {
      "start": 1359.26,
      "end": 1365.26,
      "text": "それから質問と選択肢を聞いて、"
    },
    {
      "start": 1365.26,
      "end": 1374.26,
      "text": "しから4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 1375.26,
      "end": 1379.26,
      "text": "では、始めます。"
    },
    {
      "start": 1384.26,
      "end": 1391.26,
      "text": "一番、男の人と女の人が映画について話しています。"
    },
    {
      "start": 1392.26,
      "end": 1396.26,
      "text": "田中さん、昨日を見に行った映画はどうだった?"
    },
    {
      "start": 1396.26,
      "end": 1403.26,
      "text": "一緒に行った友達は、感動して涙が止まらないって言ってたけど、私はそれほどじゃなかったんだ。"
    },
    {
      "start": 1403.26,
      "end": 1408.26,
      "text": "僕の友達も、あの映画を見るなら反価値が必要だって言ってたけど。"
    },
    {
      "start": 1408.26,
      "end": 1414.26,
      "text": "多分、人の話をたくさん聞いて、期待が大きくなり過ぎてたんだと思う。"
    },
    {
      "start": 1414.26,
      "end": 1417.26,
      "text": "そうか、そういうこともあるよね。"
    },
    {
      "start": 1417.26,
      "end": 1420.26,
      "text": "何も聞かないで見に行きたかったな。"
    },
    {
      "start": 1422.26,
      "end": 1431.26,
      "text": "女の人は、映画はどうだったと言っていますか?"
    },
    {
      "start": 1431.26,
      "end": 1436.26,
      "text": "一、とても感動した。"
    },
    {
      "start": 1436.26,
      "end": 1442.26,
      "text": "二、全く感動しなかった。"
    },
    {
      "start": 1442.26,
      "end": 1449.26,
      "text": "三、思っていたより感動した。"
    },
    {
      "start": 1450.26,
      "end": 1456.26,
      "text": "四、思っていたほど、感動しなかった。"
    },
    {
      "start": 1465.26,
      "end": 1472.26,
      "text": "二番、ルス番電話のメッセージを聞いています。"
    },
    {
      "start": 1473.26,
      "end": 1477.26,
      "text": "もしもし、田中です。"
    },
    {
      "start": 1477.26,
      "end": 1480.26,
      "text": "開けましておめでとうございます。"
    },
    {
      "start": 1480.26,
      "end": 1485.26,
      "text": "そちらにお引っ越しされて、もう1ヶ月になりますね。"
    },
    {
      "start": 1485.26,
      "end": 1489.26,
      "text": "新しいお宅はいかがですか?"
    },
    {
      "start": 1489.26,
      "end": 1498.26,
      "text": "ところで、来月、山田さんが日本に帰ってくるんで、うちで関係会をするんですが、"
    },
    {
      "start": 1499.26,
      "end": 1502.26,
      "text": "よろしければいらっしゃいませんか?"
    },
    {
      "start": 1502.26,
      "end": 1507.26,
      "text": "また明日にでもお電話いたします。"
    },
    {
      "start": 1514.26,
      "end": 1519.26,
      "text": "主な用事は、なんでしたか?"
    },
    {
      "start": 1519.26,
      "end": 1525.26,
      "text": "一、お昇月の挨拶"
    },
    {
      "start": 1525.26,
      "end": 1527.26,
      "text": "二、"
    },
    {
      "start": 1527.26,
      "end": 1531.26,
      "text": "引っ越しの挨拶"
    },
    {
      "start": 1531.26,
      "end": 1537.26,
      "text": "三、新しいうちに行く約束"
    },
    {
      "start": 1538.26,
      "end": 1543.26,
      "text": "四、関係会へのお誘い"
    },
    {
      "start": 1550.26,
      "end": 1556.26,
      "text": "三番、同じようで、アナウンサーが話しています。"
    },
    {
      "start": 1558.26,
      "end": 1564.26,
      "text": "チョコレートにはいろいろな種類がありますが、"
    },
    {
      "start": 1564.26,
      "end": 1571.26,
      "text": "実はチョコレートは長い間、飲み物として愛されていました。"
    },
    {
      "start": 1571.26,
      "end": 1579.26,
      "text": "原料のみに砂糖で甘い味をつけた、食べるチョコレートが作られたのは19世紀で、"
    },
    {
      "start": 1579.26,
      "end": 1584.26,
      "text": "日本では1879年ごろだそうです。"
    },
    {
      "start": 1585.26,
      "end": 1593.26,
      "text": "初めは、日本にない色や味だったため、人気が出るまでに時間がかかったそうです。"
    },
    {
      "start": 1597.26,
      "end": 1603.26,
      "text": "アナウンサーは、チョコレートの何について話していますか?"
    },
    {
      "start": 1603.26,
      "end": 1609.26,
      "text": "一、チョコレートの歴史"
    },
    {
      "start": 1609.26,
      "end": 1613.26,
      "text": "二、チョコレートの原料"
    },
    {
      "start": 1615.26,
      "end": 1621.26,
      "text": "三、チョコレートの種類"
    },
    {
      "start": 1621.26,
      "end": 1626.26,
      "text": "四、チョコレートの人気"
    },
    {
      "start": 1627.26,
      "end": 1633.26,
      "text": "三、チョコレートの種類"
    },
    {
      "start": 1637.26,
      "end": 1646.26,
      "text": "問題四、問題四では絵を見ながら質問を聞いてください。"
    },
    {
      "start": 1646.26,
      "end": 1651.26,
      "text": "矢印の人は何と言いますか?"
    },
    {
      "start": 1651.26,
      "end": 1660.26,
      "text": "一から三の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 1661.26,
      "end": 1666.26,
      "text": "では、始めます"
    },
    {
      "start": 1669.26,
      "end": 1671.26,
      "text": "一番"
    },
    {
      "start": 1671.26,
      "end": 1676.26,
      "text": "お世話になっていた先生に久しぶりに会いました。"
    },
    {
      "start": 1676.26,
      "end": 1679.26,
      "text": "なんと言いますか?"
    },
    {
      "start": 1679.26,
      "end": 1683.26,
      "text": "一、ごくろおさまです"
    },
    {
      "start": 1683.26,
      "end": 1687.26,
      "text": "二、お待ちどうさまです"
    },
    {
      "start": 1687.26,
      "end": 1692.26,
      "text": "三、ごぶさたしております"
    },
    {
      "start": 1703.26,
      "end": 1705.26,
      "text": "二番"
    },
    {
      "start": 1706.26,
      "end": 1712.26,
      "text": "友達のジャケットのボタンがありません。なんと言いますか?"
    },
    {
      "start": 1712.26,
      "end": 1718.26,
      "text": "一、あれ?ボタン取れてるよ?"
    },
    {
      "start": 1718.26,
      "end": 1724.26,
      "text": "二、あれ?ボタン落ちそうだよ?"
    },
    {
      "start": 1724.26,
      "end": 1730.26,
      "text": "三、あれ?ボタン取らないと?"
    },
    {
      "start": 1736.26,
      "end": 1739.26,
      "text": "三番"
    },
    {
      "start": 1739.26,
      "end": 1753.26,
      "text": "ここで写真を取ってはいけません。友達に注意します。なんと言いますか?"
    },
    {
      "start": 1753.26,
      "end": 1758.26,
      "text": "一、取るなって書いてあるよ?"
    },
    {
      "start": 1758.26,
      "end": 1763.26,
      "text": "二、取りなさいって言ってるよ?"
    },
    {
      "start": 1763.26,
      "end": 1770.26,
      "text": "三、取らなきゃいけないんだって"
    },
    {
      "start": 1780.26,
      "end": 1782.26,
      "text": "四番"
    },
    {
      "start": 1794.26,
      "end": 1797.26,
      "text": "一、是非いらっしゃってください"
    },
    {
      "start": 1797.26,
      "end": 1802.26,
      "text": "二、また誘っていただけますか?"
    },
    {
      "start": 1802.26,
      "end": 1807.26,
      "text": "三、ごいっしょさせてください"
    },
    {
      "start": 1807.26,
      "end": 1809.26,
      "text": "三、忚よみ"
    },
    {
      "start": 1825.26,
      "end": 1828.26,
      "text": "問題五"
    },
    {
      "start": 1828.26,
      "end": 1832.26,
      "text": "問題五では問題東西に何も依殺されていません"
    },
    {
      "start": 1832.26,
      "end": 1845.4,
      "text": "それからその辺時を聞いて、一から3の中から最も良いものを一つ選んでください。"
    },
    {
      "start": 1845.4,
      "end": 1850.6,
      "text": "では、始めます。"
    },
    {
      "start": 1850.6,
      "end": 1862.6,
      "text": "1番。いろいろお世話になりました。"
    },
    {
      "start": 1862.6,
      "end": 1867.6,
      "text": "1。お願いします。"
    },
    {
      "start": 1867.6,
      "end": 1871.6,
      "text": "2。こちらこそ。"
    },
    {
      "start": 1871.6,
      "end": 1876.6,
      "text": "3。大丈夫です。"
    },
    {
      "start": 1881.6,
      "end": 1890.6,
      "text": "2番。今度、市長で海外に行くんだっていいな。"
    },
    {
      "start": 1890.6,
      "end": 1895.6,
      "text": "1。本当忙しい出帳だったよ。"
    },
    {
      "start": 1895.6,
      "end": 1900.6,
      "text": "2。じゃあ、お土産買ってきてね。"
    },
    {
      "start": 1900.6,
      "end": 1905.6,
      "text": "3。遊びじゃなくて仕事だから。"
    },
    {
      "start": 1910.6,
      "end": 1915.6,
      "text": "3番。"
    },
    {
      "start": 1915.6,
      "end": 1922.6,
      "text": "佐藤君のおかげで、会議の準備、早めに終わったよ。"
    },
    {
      "start": 1922.6,
      "end": 1928.6,
      "text": "1。また手伝うから、いつでもいって。"
    },
    {
      "start": 1928.6,
      "end": 1933.6,
      "text": "2。手伝ってくれてありがとう。"
    },
    {
      "start": 1933.6,
      "end": 1938.6,
      "text": "3。何から始めればいい?"
    },
    {
      "start": 1941.6,
      "end": 1945.6,
      "text": "4番。"
    },
    {
      "start": 1945.6,
      "end": 1950.6,
      "text": "4番。"
    },
    {
      "start": 1950.6,
      "end": 1957.6,
      "text": "佐藤さん、ピザが届きましたよ。さめないうちに食べませんか。"
    },
    {
      "start": 1957.6,
      "end": 1962.6,
      "text": "1。あとで食べるっていうことですか?"
    },
    {
      "start": 1962.6,
      "end": 1969.6,
      "text": "2。じゃあ、暖かいうちに、ありがとうございます。"
    },
    {
      "start": 1969.6,
      "end": 1976.6,
      "text": "3。さめちゃったんですか。"
    },
    {
      "start": 1983.6,
      "end": 1990.6,
      "text": "5番。すごい雨だね。やみそうにないね。"
    },
    {
      "start": 1990.6,
      "end": 1995.6,
      "text": "1。雨、やんでよかったです。"
    },
    {
      "start": 1996.6,
      "end": 2000.6,
      "text": "2。ずっと降りそうですね。"
    },
    {
      "start": 2000.6,
      "end": 2005.6,
      "text": "3。かさはいらないでしょうね。"
    },
    {
      "start": 2015.6,
      "end": 2017.6,
      "text": "6番。"
    },
    {
      "start": 2017.6,
      "end": 2022.6,
      "text": "肉ばかり食べてないで、少しは野菜も食べなさい。"
    },
    {
      "start": 2022.6,
      "end": 2024.6,
      "text": "1。"
    },
    {
      "start": 2024.6,
      "end": 2028.6,
      "text": "野菜は食べなくてもいいってこと?"
    },
    {
      "start": 2028.6,
      "end": 2029.6,
      "text": "2。"
    },
    {
      "start": 2029.6,
      "end": 2033.6,
      "text": "肉だけじゃなくて、野菜も食べてるよ。"
    },
    {
      "start": 2033.6,
      "end": 2035.6,
      "text": "3。"
    },
    {
      "start": 2035.6,
      "end": 2038.6,
      "text": "肉だけ食べなくちゃいけないの?"
    },
    {
      "start": 2048.6,
      "end": 2050.6,
      "text": "7番。"
    },
    {
      "start": 2050.6,
      "end": 2054.6,
      "text": "3。リーさんにこの処理、コピーだけじゃなくて、"
    },
    {
      "start": 2054.6,
      "end": 2058.6,
      "text": "保地キスで止めるのもたのんだよね。"
    },
    {
      "start": 2058.6,
      "end": 2060.6,
      "text": "1。"
    },
    {
      "start": 2060.6,
      "end": 2064.6,
      "text": "あ、うっかりしてました。すぐやります。"
    },
    {
      "start": 2064.6,
      "end": 2066.6,
      "text": "2。"
    },
    {
      "start": 2066.6,
      "end": 2069.6,
      "text": "保地キスはしなくていいんですか?"
    },
    {
      "start": 2069.6,
      "end": 2071.6,
      "text": "3。"
    },
    {
      "start": 2071.6,
      "end": 2075.6,
      "text": "コピーだけだったんですね。"
    },
    {
      "start": 2081.6,
      "end": 2084.6,
      "text": "8番。"
    },
    {
      "start": 2084.6,
      "end": 2087.6,
      "text": "新しい商品のアイデアは、"
    },
    {
      "start": 2087.6,
      "end": 2092.6,
      "text": "そうしたからボシュースタ方がいいのではないでしょうか。"
    },
    {
      "start": 2092.6,
      "end": 2094.6,
      "text": "1。"
    },
    {
      "start": 2094.6,
      "end": 2099.6,
      "text": "そうですね。募集する方向でいきましょう。"
    },
    {
      "start": 2099.6,
      "end": 2101.6,
      "text": "2。"
    },
    {
      "start": 2101.6,
      "end": 2105.6,
      "text": "じゃあ、募集をやめるってことですか?"
    },
    {
      "start": 2105.6,
      "end": 2107.6,
      "text": "3。"
    },
    {
      "start": 2107.6,
      "end": 2111.6,
      "text": "商品者からは募集しないんですね。"
    },
    {
      "start": 2121.6,
      "end": 2123.6,
      "text": "9番。"
    },
    {
      "start": 2123.6,
      "end": 2128.6,
      "text": "電話でお願いした資料、取りに来たんですけど。"
    },
    {
      "start": 2128.6,
      "end": 2129.6,
      "text": "1。"
