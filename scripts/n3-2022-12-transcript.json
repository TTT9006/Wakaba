    {
      "start": 704.15,
      "end": 705.15,
      "text": "きれいなことが"
    },
    {
      "start": 705.15,
      "end": 706.15,
      "text": "ないか"
    },
    {
      "start": 706.15,
      "end": 707.15,
      "text": "この方だったら"
    },
    {
      "start": 707.15,
      "end": 708.15,
      "text": "この方だと"
    },
    {
      "start": 708.15,
      "end": 709.15,
      "text": "そのように"
    },
    {
      "start": 709.15,
      "end": 710.15,
      "text": "あくれるこの話で"
    },
    {
      "start": 710.15,
      "end": 711.15,
      "text": "ひとつで"
    },
    {
      "start": 711.15,
      "end": 712.15,
      "text": "やりなかったら"
    },
    {
      "start": 712.15,
      "end": 713.15,
      "text": "変わり"
    },
    {
      "start": 713.15,
      "end": 714.15,
      "text": "ここよかったのか"
    },
    {
      "start": 714.15,
      "end": 716.15,
      "text": "でも"
    },
    {
      "start": 716.15,
      "end": 717.15,
      "text": "と"
    },
    {
      "start": 717.15,
      "end": 719.15,
      "text": "このどこが"
    },
    {
      "start": 719.15,
      "end": 725.65,
      "text": "この方が"
    },
    {
      "start": 725.65,
      "end": 727.15,
      "text": "これから"
    },
    {
      "start": 727.15,
      "end": 734.91,
      "text": "この子たちは"
    },
    {
      "start": 734.91,
      "end": 752.14,
      "text": "このことの"
    },
    {
      "start": 752.14,
      "end": 754.14,
      "text": "私たちは"
    },
    {
      "start": 754.14,
      "end": 757.14,
      "text": "どんなことを"
    },
    {
      "start": 757.14,
      "end": 784.86,
      "text": "どうぞガラクテータ。大学学生にどんどん学ぶのって思った。"
    },
    {
      "start": 784.86,
      "end": 788.06,
      "text": "平日、企業に入れるのでおはようなのかと思って、"
    },
    {
      "start": 788.06,
      "end": 789.82,
      "text": "ひどいなばならない日も平日にして、"
    },
    {
      "start": 789.82,
      "end": 792.06,
      "text": "悪日にしていってね。"
    },
    {
      "start": 792.06,
      "end": 795.5,
      "text": "っても、うまくなくて読んでいるのに思ったので。"
    },
    {
      "start": 795.5,
      "end": 797.22,
      "text": "企業に雲生くことだったんじゃないですか。"
    },
    {
      "start": 797.22,
      "end": 798.46,
      "text": "はい。"
    },
    {
      "start": 798.46,
      "end": 801.72,
      "text": "なかなか練習をもうちょっと無いことにはできるか?"
    },
    {
      "start": 801.72,
      "end": 805.04,
      "text": "練習の作業は、こんなのにも練習がほんと、"
    },
    {
      "start": 805.04,
      "end": 807.86,
      "text": "ただ、駄目と練習で練習すると、"
    },
    {
      "start": 807.86,
      "end": 810.86,
      "text": "大学は止まって、中のことがありで通報"
    },
    {
      "start": 810.86,
      "end": 814.86,
      "text": "今日は、生き日の20時間の短さを見事かさせてみます"
    },
    {
      "start": 814.86,
      "end": 817.86,
      "text": "練習時代にさるのは、広がるので"
    },
    {
      "start": 817.86,
      "end": 821.86,
      "text": "いや、12時に時間は、生き日のことを待っていて、誰かとならなかった"
    },
    {
      "start": 821.86,
      "end": 825.86,
      "text": "練習に過ぎて、生き日な方を、あなたと呼びたいと思っていません"
    },
    {
      "start": 825.86,
      "end": 837.12,
      "text": "なんか、みんなか、入れてもらわいます"
    },
    {
      "start": 837.12,
      "end": 840.12,
      "text": "女の方が生きてみます"
    },
    {
      "start": 907.98,
      "end": 915.51,
      "text": "練習は、両方のことがあり、あなたと呼んで、おでるのを見事かさら、"
    },
    {
      "start": 915.51,
      "end": 918.51,
      "text": "おでるのを見事かさせてみます"
    },
    {
      "start": 918.51,
      "end": 923.51,
      "text": "おでるのを見事かさら、ごぼは次は、暴れに見事かされていました"
    },
    {
      "start": 923.51,
      "end": 951.93,
      "text": "暴れにして、生き寒いことをしてみます"
    },
    {
      "start": 951.93,
      "end": 975.63,
      "text": "どうして、この次の、あなたのことをしてみます"
    },
    {
      "start": 975.63,
      "end": 977.63,
      "text": "生き寒いことをしてみます"
    },
    {
      "start": 977.63,
      "end": 980.63,
      "text": "知論者のことを何さか、あなたのことを思ってみますか"
    },
    {
      "start": 1082.36,
      "end": 1086.36,
      "text": "このことが、あなたともは、練習を復帰してみます"
    },
    {
      "start": 1086.36,
      "end": 1090.36,
      "text": "みてで、今までの練習をとても、改めての前からのよりなら"
    },
    {
      "start": 1090.36,
      "end": 1096.36,
      "text": "それぞれ用意したら、もう大きなことは、いつも自分自身を貫いたかったのに、もう考えたかったです"
    },
    {
      "start": 1096.36,
      "end": 1106.95,
      "text": "すると、もう、一つずりを考えたかったら、あなたは、あなたと呼んでいます"
    },
    {
      "start": 1106.95,
      "end": 1126.05,
      "text": "いいのがいいですか、何?関係は、何?"
    },
    {
      "start": 1126.05,
      "end": 1181.01,
      "text": "どんななにをか、思うんだね、思わないとなって、よくいいですか、お願いします"
    },
    {
      "start": 1228.19,
      "end": 1231.19,
      "text": "今、早めのことをしても、関係が何になるのか?"
    },
    {
      "start": 1231.19,
      "end": 1236.19,
      "text": "うん、早めのことになるのか、あなたのことが、早めのことを思い出してみます"
    },
    {
      "start": 1236.19,
      "end": 1240.19,
      "text": "思わずに、ここでもいいのに、なりゃなければならない"
    },
    {
      "start": 1240.19,
      "end": 1256.08,
      "text": "どうなんでね、わたしは、あなたがやってみても、練習のことをせるならないですか"
    },
    {
      "start": 1256.08,
      "end": 1299.82,
      "text": "英語をなりゃあなたのことを、あなたのことに、あなたが知っているのに、それを思い出すことを知って、すいませんが、かせていまーす"
    },
    {
      "start": 1374.52,
      "end": 1377.52,
      "text": "私たちの人体、事業を全体に立ててもらえない"
    },
    {
      "start": 1377.52,
      "end": 1386.52,
      "text": "事業を名前やつよりも、見て、女なのなにをかどうぞ、同じやなと、事業をかくましてた、思っていたことを聞かせてもらえない"
    },
    {
      "start": 1386.52,
      "end": 1391.52,
      "text": "また、なにをかい立ちそうだという、医療で全体に立てたくるのを、よくあってはない"
    },
    {
      "start": 1391.52,
      "end": 1399.52,
      "text": "今日、事業を伝説をさせたり、全体の経験を聞いざるして、情報を負けるのもいいと思っています"
    }
  ]
}