{
  "source": "c:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N3\\n3\\n3\\12-2021\\Nghe N3 T12-2021 bản chuẩn Yuuki Bùi.mp3",
  "duration": 2597.4335,
  "segments": [
    {
      "start": 0.0,
      "end": 8.24,
      "text": "これから、音を聞いてください。"
    },
    {
      "start": 8.24,
      "end": 15.32,
      "text": "音がよく聞こえない時は、手を上げてください。"
    },
    {
      "start": 15.32,
      "end": 18.8,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 18.8,
      "end": 22.36,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 22.36,
      "end": 25.8,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 25.8,
      "end": 29.8,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 36.2,
      "end": 46.88,
      "text": "2021年、第2回、日本語能力試験、超快、N3。"
    },
    {
      "start": 46.88,
      "end": 53.28,
      "text": "これから、N3の超快試験を始めます。"
    },
    {
      "start": 53.28,
      "end": 59.16,
      "text": "問題用士にメモをとってもいいです。"
    },
    {
      "start": 59.16,
      "end": 63.76,
      "text": "問題用士を開けてください。"
    },
    {
      "start": 63.76,
      "end": 70.12,
      "text": "問題用士のページがない時は、手を上げてください。"
    },
    {
      "start": 70.12,
      "end": 75.6,
      "text": "問題がよく見えない時も、手を上げてください。"
    },
    {
      "start": 75.6,
      "end": 79.36,
      "text": "いつでもいいです。"
    },
    {
      "start": 84.28,
      "end": 86.28,
      "text": "問題1。"
    },
    {
      "start": 86.28,
      "end": 91.44,
      "text": "問題1では、まず質問を聞いてください。"
    },
    {
      "start": 91.44,
      "end": 97.08,
      "text": "それから話を聞いて、問題用士の1から4の中から、"
    },
    {
      "start": 97.08,
      "end": 101.88,
      "text": "最も良いものを一つ選んでください。"
    },
    {
      "start": 102.88,
      "end": 106.88,
      "text": "では、練習しましょう。"
    },
    {
      "start": 111.36,
      "end": 112.72,
      "text": "で、"
    },
    {
      "start": 112.84,
      "end": 118.56,
      "text": "ホテルで会社員の男の人と女の人が話しています。"
    },
    {
      "start": 118.56,
      "end": 124.36,
      "text": "女の人は、明日、何時までにホテルを出ますか?"
    },
    {
      "start": 126.64,
      "end": 130.96,
      "text": "では、明日は、9時半に事務所にいらしてください。"
    },
    {
      "start": 130.96,
      "end": 135.76,
      "text": "はい、えーっと、このホテルから事務所まで、"
    },
    {
      "start": 135.76,
      "end": 138.56,
      "text": "たくしでどのくらいかかりますか?"
    },
    {
      "start": 138.56,
      "end": 142.4,
      "text": "そうですね、30分もあればつきますね。"
    },
    {
      "start": 142.4,
      "end": 145.6,
      "text": "じゃあ、9時に出ればいいですね。"
    },
    {
      "start": 145.6,
      "end": 149.4,
      "text": "あ、朝は道が細かもしれません。"
    },
    {
      "start": 149.4,
      "end": 152.76,
      "text": "15分ぐらい早めに出られた方がいいですね。"
    },
    {
      "start": 152.76,
      "end": 156.6,
      "text": "そうですか。じゃあそうします。"
    },
    {
      "start": 163.36,
      "end": 169.72,
      "text": "女の人は、明日、何時までにホテルを出ますか?"
    },
    {
      "start": 169.72,
      "end": 174.36,
      "text": "最も良いものは、一番です。"
    },
    {
      "start": 174.36,
      "end": 181.72,
      "text": "回答用士の問題1の例のところを見てください。"
    },
    {
      "start": 181.72,
      "end": 190.56,
      "text": "最も良いものは、一番ですから、答えはこのように書きます。"
    },
    {
      "start": 191.56,
      "end": 195.56,
      "text": "では、始めます。"
    },
    {
      "start": 199.72,
      "end": 208.68,
      "text": "一番、花屋で男の人とてんいんがある花について話しています。"
    },
    {
      "start": 208.68,
      "end": 216.92,
      "text": "男の人は、この花に水をやる時、どのように水をやりますか?"
    },
    {
      "start": 216.92,
      "end": 220.96,
      "text": "この花を書いたいんですけど、せ忘るの楽ですか?"
    },
    {
      "start": 221.12,
      "end": 224.88,
      "text": "え、水をやるだけでいいんですよ。"
    },
    {
      "start": 224.88,
      "end": 230.48,
      "text": "水は土が乾いた時に、熱子の方にだけやるようにしてください。"
    },
    {
      "start": 230.48,
      "end": 232.48,
      "text": "葉っぱにかからないように。"
    },
    {
      "start": 232.48,
      "end": 234.64,
      "text": "上からかけちゃいけないんですか?"
    },
    {
      "start": 234.64,
      "end": 238.76,
      "text": "しっけで壁が生えたり、くさったりすることがあるので。"
    },
    {
      "start": 238.76,
      "end": 241.4,
      "text": "そうなんですか、気をつけます。"
    },
    {
      "start": 241.4,
      "end": 247.4,
      "text": "水をやった後、下のお皿に水が溜まっていたら、水は捨ててくださいね。"
    },
    {
      "start": 247.4,
      "end": 250.4,
      "text": "わかりました。"
    },
    {
      "start": 251.4,
      "end": 261.2,
      "text": "男の人は、この花に水をやる時、どのように水をやりますか?"
    },
    {
      "start": 261.2,
      "end": 268.2,
      "text": "2番"
    },
    {
      "start": 268.2,
      "end": 280.2,
      "text": "駅のプラットホームで、女の人と駅員が話しています。"
    },
    {
      "start": 280.2,
      "end": 286.2,
      "text": "女の人は、何番線の電車に乗りますか?"
    },
    {
      "start": 291.4,
      "end": 298.2,
      "text": "すみません。南海岸駅の電車は、このホームの3番線で待てばいいんですか?"
    },
    {
      "start": 298.2,
      "end": 303.0,
      "text": "それとも、向海岸の4番線に止まっている電車ですか?"
    },
    {
      "start": 303.0,
      "end": 307.0,
      "text": "どちらも、南海岸とは反対方向ですね。"
    },
    {
      "start": 307.0,
      "end": 308.8,
      "text": "どちらもで行かれます?"
    },
    {
      "start": 308.8,
      "end": 310.6,
      "text": "山川駅まで。"
    },
    {
      "start": 310.6,
      "end": 314.2,
      "text": "じゃあ、2番線の駆け駅停車ですね。"
    },
    {
      "start": 314.4,
      "end": 323.2,
      "text": "同じホームに一番線もあるんですが、そちらは急行電車で、山川駅には止まりませんから気をつけてください。"
    },
    {
      "start": 323.2,
      "end": 330.6,
      "text": "えっとですね、この3番線と4番線のホームを全部進むと階段があります。"
    },
    {
      "start": 330.6,
      "end": 334.4,
      "text": "それを上がると南海岸のホームに出ますから。"
    },
    {
      "start": 334.4,
      "end": 336.2,
      "text": "ありがとうございます。"
    },
    {
      "start": 336.2,
      "end": 343.2,
      "text": "4番線の電車がもうすぐ出ますので、ホームを歩く時気をつけてくださいね。"
    },
    {
      "start": 344.5,
      "end": 348.2,
      "text": "5番線の電車。"
    },
    {
      "start": 348.2,
      "end": 354.2,
      "text": "女の人は南番線の電車に乗りますか?"
    },
    {
      "start": 369.2,
      "end": 370.2,
      "text": "3番。"
    },
    {
      "start": 370.2,
      "end": 377.32,
      "text": "女の学生と先生が話しています 女の学生はレポートのどこを"
    },
    {
      "start": 377.32,
      "end": 383.96,
      "text": "なおしますか 先生レポートを書いたんですがこれでよろしい"
    },
    {
      "start": 383.96,
      "end": 387.88,
      "text": "でしょうか もう書いたんですか"
    },
    {
      "start": 387.88,
      "end": 395.08,
      "text": "早いですね 内容は後で見ますね タイトルの書き方はこれでいいですか"
    },
    {
      "start": 395.08,
      "end": 399.08,
      "text": "うん問題ないですよ これでいいでしょう"
    },
    {
      "start": 399.08,
      "end": 406.36,
      "text": "ありがとうございます 他は名前も書いてあるし 番号も書いてあるし"
    },
    {
      "start": 406.36,
      "end": 413.76,
      "text": "でも名前は漁字も書いてください それから仮目が間違っていますね"
    },
    {
      "start": 413.76,
      "end": 418.52,
      "text": "この授業は世界の文学ですよ 日本じゃなくて"
    },
    {
      "start": 418.52,
      "end": 423.48,
      "text": "あすみません それを直してもう一度出してください"
    },
    {
      "start": 423.48,
      "end": 425.52,
      "text": "はい"
    },
    {
      "start": 429.64,
      "end": 435.64,
      "text": "女の学生はレポートのどこをなおしますか"
    },
    {
      "start": 449.24,
      "end": 456.44,
      "text": "4番 会社で上司からのルス番電話のメッセージを聴いています"
    },
    {
      "start": 456.44,
      "end": 461.76,
      "text": "この後まず何をしなければなりませんか"
    },
    {
      "start": 464.64,
      "end": 473.16,
      "text": "あもしもし佐藤ですが 実は昨日の書類を会社において来てしまって"
    },
    {
      "start": 473.16,
      "end": 479.32,
      "text": "私の机の上にあるんですが 今に郵便局に行って出して来てください"
    },
    {
      "start": 479.32,
      "end": 487.04,
      "text": "あそうそうその前に忘れずに無調に頼んで 書類に参加してもらってください"
    },
    {
      "start": 487.04,
      "end": 492.36,
      "text": "優募したら確認のために私の形態に電話をお願いします"
    },
    {
      "start": 492.36,
      "end": 495.36,
      "text": "じゃあよろしく"
    },
    {
      "start": 495.36,
      "end": 507.96,
      "text": "この後まず何をしなければなりませんか"
    },
    {
      "start": 507.96,
      "end": 514.96,
      "text": "5番"
    },
    {
      "start": 514.96,
      "end": 535.64,
      "text": "同じクラブの女の学生と男の学生が話しています 男の学生は最初に何をしなければなりませんか"
    },
    {
      "start": 535.64,
      "end": 543.96,
      "text": "松本君 私明日から旅行に行くんでちょっとお願いしたいことがあるんだけど"
    },
    {
      "start": 543.96,
      "end": 545.8,
      "text": "どんなこと"
    },
    {
      "start": 545.8,
      "end": 555.4,
      "text": "新入生のパーティーについてどんなふうにやるか みんなに意見を聞いて案を作ってほしいんだけど今集中に"
    },
    {
      "start": 555.4,
      "end": 563.0,
      "text": "えっとメールで意見を聞いて案を作ればいいよね"
    },
    {
      "start": 563.0,
      "end": 569.76,
      "text": "できたら会議をしてほしいんだけど メールだと意見いわない人いるから"
    },
    {
      "start": 569.76,
      "end": 576.64,
      "text": "春休みだからみんなが集まるのはちょっと難しいんじゃないかな"
    },
    {
      "start": 576.64,
      "end": 580.24,
      "text": "そうかな"
    },
    {
      "start": 580.24,
      "end": 590.36,
      "text": "みんなのつもがつかなかったらメールでも構わないけど まずみんなに連絡して集まれるかどうか確認してよ"
    },
    {
      "start": 590.36,
      "end": 593.84,
      "text": "うん わかったよ"
    },
    {
      "start": 597.84,
      "end": 604.32,
      "text": "男の学生は最初に何をしなければなりませんか"
    },
    {
      "start": 604.32,
      "end": 611.32,
      "text": "ん"
    },
    {
      "start": 611.32,
      "end": 618.32,
      "text": "6番"
    },
    {
      "start": 618.32,
      "end": 625.4,
      "text": "6番 仕役所で男の人と仕役所の人が話しています"
    },
    {
      "start": 625.4,
      "end": 631.84,
      "text": "男の人は卓球教室に何を持っていきますか"
    },
    {
      "start": 631.84,
      "end": 637.6,
      "text": "すみません 形自番で中級者向けの卓球教室があるってみまして"
    },
    {
      "start": 637.6,
      "end": 640.44,
      "text": "レッスン料は無料って書いてあったんですけど"
    },
    {
      "start": 640.44,
      "end": 647.08,
      "text": "はい レッスンは無料なんですが卓球ルームの利用料としておひとり200円"
    },
    {
      "start": 647.08,
      "end": 652.88,
      "text": "参加されるときに毎回いただいています あそう書いてあったかもしれない"
    },
    {
      "start": 652.88,
      "end": 657.16,
      "text": "すみませんきちんと読んでなくて もしかみます"
    },
    {
      "start": 657.16,
      "end": 664.24,
      "text": "では こちらの髪にお名前とご連絡先をお願いします"
    },
    {
      "start": 664.24,
      "end": 671.72,
      "text": "教室は来週の日曜日から始まります 充実に直接教室にいらっしゃってください"
    },
    {
      "start": 671.72,
      "end": 675.56,
      "text": "えーとラケットは50分のを使われますか"
    },
    {
      "start": 675.56,
      "end": 679.32,
      "text": "はい ラケットもボールも自分の思ってきます"
    },
    {
      "start": 679.32,
      "end": 686.56,
      "text": "あ ボールはなくなったり他の方に間違って持って帰られてしまうことがありますので"
    },
    {
      "start": 686.56,
      "end": 692.72,
      "text": "個人のものを使いにならないようお願いします わかりました"
    },
    {
      "start": 696.88,
      "end": 703.48,
      "text": "男の人は卓球教室に何を持っていきますか"
    },
    {
      "start": 717.56,
      "end": 726.16,
      "text": "問題に 問題にではまず質問を聞いてください"
    },
    {
      "start": 726.16,
      "end": 731.24,
      "text": "その後 問題用士を見てください"
    },
    {
      "start": 731.24,
      "end": 737.72,
      "text": "読む時間があります それから話を聞いて"
    },
    {
      "start": 737.72,
      "end": 748.84,
      "text": "問題用士の1から4の中から 最も良いものを一つ選んでください"
    },
    {
      "start": 749.72,
      "end": 754.56,
      "text": "では 練習しましょう"
    },
    {
      "start": 759.32,
      "end": 765.8,
      "text": "で 女の人と男の人がスーパーで話しています"
    },
    {
      "start": 765.8,
      "end": 771.72,
      "text": "男の人はどうして自分で料理をしませんか"
    },
    {
      "start": 795.8,
      "end": 798.8,
      "text": "あら 田中くお買い物"
    },
    {
      "start": 798.8,
      "end": 801.32,
      "text": "うん 夕晩お買いにね"
    },
    {
      "start": 801.32,
      "end": 806.24,
      "text": "お弁当 自分で作らないの 時間ないか"
    },
    {
      "start": 806.24,
      "end": 807.92,
      "text": "いや そうじゃないんだ"
    },
    {
      "start": 807.92,
      "end": 810.12,
      "text": "じゃあ 作ればいいのに"
    },
    {
      "start": 810.12,
      "end": 812.36,
      "text": "作るのは嫌いじゃないんだ"
    },
    {
      "start": 812.36,
      "end": 815.76,
      "text": "でも一人だと 材料が余っちゃう"
    },
    {
      "start": 815.76,
      "end": 821.88,
      "text": "それはいいんだけど 一生懸命作っても一人で食べるだけじゃなんか寂しくて"
    },
    {
      "start": 821.88,
      "end": 824.24,
      "text": "それもそうか"
    },
    {
      "start": 825.8,
      "end": 837.12,
      "text": "男の人はどうして自分で料理をしませんか"
    },
    {
      "start": 837.12,
      "end": 842.28,
      "text": "最も良いものは4番です"
    },
    {
      "start": 842.28,
      "end": 849.96,
      "text": "買い通用士の問題にの 例のところを見てください"
    },
    {
      "start": 849.96,
      "end": 854.64,
      "text": "最も良いものは4番ですから"
    },
    {
      "start": 854.64,
      "end": 858.72,
      "text": "答えはこのように書きます"
    },
    {
      "start": 859.88,
      "end": 863.88,
      "text": "では 始めます"
    },
    {
      "start": 868.36,
      "end": 869.96,
      "text": "一番"
    },
    {
      "start": 869.96,
      "end": 874.16,
      "text": "男の人と女の人が話しています"
    },
    {
      "start": 874.16,
      "end": 882.08,
      "text": "女の人は新しい家について 何が一番良いと言っていますか"
    },
    {
      "start": 904.16,
      "end": 908.24,
      "text": "あ 家庁 非こし大変でしたね"
    },
    {
      "start": 908.24,
      "end": 910.68,
      "text": "お楽しいお宅どうですか"
    },
    {
      "start": 910.68,
      "end": 914.4,
      "text": "うん 前の家よりも広いしね"
    },
    {
      "start": 914.4,
      "end": 917.68,
      "text": "駅からも近いし 住みやすいのよ"
    },
    {
      "start": 917.68,
      "end": 920.84,
      "text": "へぇいいですね"
    },
    {
      "start": 920.84,
      "end": 925.44,
      "text": "でも 一番気に言ってるのはニュアがあること"
    },
    {
      "start": 925.44,
      "end": 928.0,
      "text": "今度みんなで遊びに来ない"
    },
    {
      "start": 928.0,
      "end": 930.2,
      "text": "いいんですか"
    },
    {
      "start": 930.2,
      "end": 935.96,
      "text": "もちろんよパーティーでもしましょうよ 会社からも近いしね"
    },
    {
      "start": 935.96,
