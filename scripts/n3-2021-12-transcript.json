    },
    {
      "start": 1292.0,
      "end": 1306.08,
      "text": "ラジオで女の人が自分の趣味について話しています"
    },
    {
      "start": 1306.08,
      "end": 1314.08,
      "text": "女の人は家で野菜を作り始めて良かったことはなんだと言っていますか"
    },
    {
      "start": 1318.0,
      "end": 1322.0,
      "text": "私"
    },
    {
      "start": 1322.0,
      "end": 1327.6,
      "text": "最近家のにはで野菜を作り始めたんです"
    },
    {
      "start": 1327.6,
      "end": 1342.6,
      "text": "前から早起きなんですけど今は朝起きたらまず野菜を作り始めた"
    },
    {
      "start": 1342.6,
      "end": 1354.6,
      "text": "金序でも野菜を作っている人が意外に多くてそれまでは話したことがなかった人たちと"
    },
    {
      "start": 1354.6,
      "end": 1362.6,
      "text": "したしくなることができました共通の趣味ができたおかげですね"
    },
    {
      "start": 1362.6,
      "end": 1370.6,
      "text": "中には家でたくさん作っていて店で野菜は変わないという人もいるんですよ"
    },
    {
      "start": 1371.6,
      "end": 1376.6,
      "text": "野菜ができたら野菜が苦手な魔法にも食べさせたいです"
    },
    {
      "start": 1376.6,
      "end": 1384.6,
      "text": "新鮮な野菜なら野菜が好きになってくれるかもと期待しています"
    },
    {
      "start": 1388.6,
      "end": 1397.6,
      "text": "女の人は家で野菜を作り始めて良かったことはなんだと言っていますか"
    },
    {
      "start": 1400.6,
      "end": 1404.6,
      "text": "6番"
    },
    {
      "start": 1404.6,
      "end": 1409.6,
      "text": "女の人と男の人が話しています"
    },
    {
      "start": 1409.6,
      "end": 1421.6,
      "text": "雑誌に乗った写真はどんな写真ですか"
    },
    {
      "start": 1430.6,
      "end": 1444.6,
      "text": "野菜はどんな写真を取っているのか"
    },
    {
      "start": 1444.6,
      "end": 1450.6,
      "text": "野菜はどんな写真を取っているのか"
    },
    {
      "start": 1451.6,
      "end": 1456.6,
      "text": "家式を取ったりにはで遊んでいる子供たちを取ったりいろいろだよ"
    },
    {
      "start": 1456.6,
      "end": 1461.6,
      "text": "僕の写真はこの間写真に乗ったんだよ"
    },
    {
      "start": 1461.6,
      "end": 1464.6,
      "text": "すごいですねどんな写真ですか"
    },
    {
      "start": 1464.6,
      "end": 1469.6,
      "text": "夏休みに子供を連れて盛り山自然公園に行ってね"
    },
    {
      "start": 1469.6,
      "end": 1473.6,
      "text": "花がとっても綺麗だったからそれを取ろうと思ったんだけど"
    },
    {
      "start": 1473.6,
      "end": 1477.6,
      "text": "あそこは池の周りの花が有名ですよね"
    },
    {
      "start": 1478.6,
      "end": 1482.6,
      "text": "だけど言ってみたら池に見たことない珍しい取りがいてね"
    },
    {
      "start": 1482.6,
      "end": 1484.6,
      "text": "それを取ったんだよ"
    },
    {
      "start": 1484.6,
      "end": 1489.6,
      "text": "あの池は魚がいるから魚を取りに来たのかもしれませんね"
    },
    {
      "start": 1489.6,
      "end": 1491.6,
      "text": "ああそうか"
    },
    {
      "start": 1496.6,
      "end": 1500.6,
      "text": "雑誌に乗った写真はどんな写真ですか"
    },
    {
      "start": 1507.6,
      "end": 1514.6,
      "text": "ここでちょっと休みましょう"
    },
    {
      "start": 1537.6,
      "end": 1544.6,
      "text": "ではまた続けます"
    },
    {
      "start": 1548.6,
      "end": 1558.6,
      "text": "問題3"
    },
    {
      "start": 1558.6,
      "end": 1565.6,
      "text": "問題3では問題用紙に何も印刷されていません"
    },
    {
      "start": 1566.6,
      "end": 1572.6,
      "text": "この問題は全体としてどんな内容化を聞く問題です"
    },
    {
      "start": 1572.6,
      "end": 1577.6,
      "text": "話の前に質問はありません"
    },
    {
      "start": 1577.6,
      "end": 1582.6,
      "text": "まず話を聞いてください"
    },
    {
      "start": 1582.6,
      "end": 1587.6,
      "text": "それから質問と選択肢を聞いて"
    },
    {
      "start": 1587.6,
      "end": 1594.6,
      "text": "1から4の中から最も良いものを一つ選んでください"
    },
    {
      "start": 1594.6,
      "end": 1602.6,
      "text": "では練習しましょう"
    },
    {
      "start": 1606.6,
      "end": 1607.6,
      "text": "で"
    },
    {
      "start": 1607.6,
      "end": 1614.6,
      "text": "女の人が友達のうちに来て話しています"
    },
    {
      "start": 1615.6,
      "end": 1617.6,
      "text": "田中です"
    },
    {
      "start": 1621.6,
      "end": 1626.6,
      "text": "昨日友達がとまりに来てたんで片付いてないけど"
    },
    {
      "start": 1626.6,
      "end": 1628.6,
      "text": "はいって"
    },
    {
      "start": 1628.6,
      "end": 1631.6,
      "text": "でもここですぐ帰るから"
    },
    {
      "start": 1631.6,
      "end": 1637.6,
      "text": "あのこの前カリタ本なんだけどちょっと破れちゃって"
    },
    {
      "start": 1637.6,
      "end": 1639.6,
      "text": "本当?"
    },
    {
      "start": 1639.6,
      "end": 1642.6,
      "text": "このページなんだけど"
    },
    {
      "start": 1642.6,
      "end": 1647.6,
      "text": "このくらいなら大丈夫読めるし"
    },
    {
      "start": 1647.6,
      "end": 1652.6,
      "text": "本当?ごめんこれからは気をつけるから"
    },
    {
      "start": 1652.6,
      "end": 1654.6,
      "text": "いいよ"
    },
    {
      "start": 1654.6,
      "end": 1657.6,
      "text": "ね、帰ってコーヒーでも飲んでいかない?"
    },
    {
      "start": 1657.6,
      "end": 1660.6,
      "text": "ありがとう"
    },
    {
      "start": 1664.6,
      "end": 1670.6,
      "text": "女の人は友達のうちに何をしに来ましたか?"
    },
    {
      "start": 1670.6,
      "end": 1672.6,
      "text": "1"
    },
    {
      "start": 1672.6,
      "end": 1674.6,
      "text": "あやまりに来た"
    },
    {
      "start": 1674.6,
      "end": 1676.6,
      "text": "2"
    },
    {
      "start": 1676.6,
      "end": 1679.6,
      "text": "本をカリに来た"
    },
    {
      "start": 1679.6,
      "end": 1681.6,
      "text": "3"
    },
    {
      "start": 1681.6,
      "end": 1683.6,
      "text": "とまりに来た"
    },
    {
      "start": 1683.6,
      "end": 1685.6,
      "text": "4"
    },
    {
      "start": 1685.6,
      "end": 1688.6,
      "text": "コーヒーを飲みに来た"
    },
    {
      "start": 1688.6,
      "end": 1693.6,
      "text": "最も良いものは一番です"
    },
    {
      "start": 1693.6,
      "end": 1700.6,
      "text": "回答用士の問題さんの例のところを見てください"
    },
    {
      "start": 1700.6,
      "end": 1705.6,
      "text": "最も良いものは一番ですから"
    },
    {
      "start": 1705.6,
      "end": 1709.6,
      "text": "答えはこのように書きます"
    },
    {
      "start": 1710.6,
      "end": 1714.6,
      "text": "では始めます"
    },
    {
      "start": 1718.6,
      "end": 1720.6,
      "text": "一番"
    },
    {
      "start": 1720.6,
      "end": 1725.6,
      "text": "女の学生と男の学生が話しています"
    },
    {
      "start": 1727.6,
      "end": 1729.6,
      "text": "佐藤君"
    },
    {
      "start": 1729.6,
      "end": 1735.6,
      "text": "佐藤君ってあの雑誌によく出てる青山っていうレストランでアレバイトしてるよね"
    },
    {
      "start": 1735.6,
      "end": 1737.6,
      "text": "どう?"
    },
    {
      "start": 1737.6,
      "end": 1740.6,
      "text": "料理のこともいろいろ教えてもらえるし"
    },
    {
      "start": 1740.6,
      "end": 1743.6,
      "text": "バイト仲間も良い人ばかりですごく楽しいよ"
    },
    {
      "start": 1743.6,
      "end": 1745.6,
      "text": "いいね"
    },
    {
      "start": 1745.6,
      "end": 1748.6,
      "text": "実は今ね、バイト探してるんだけど"
    },
    {
      "start": 1748.6,
      "end": 1751.6,
      "text": "そこ、人を募集してない?"
    },
    {
      "start": 1751.6,
      "end": 1755.6,
      "text": "どうだろう、今度を店の人に聞いてみるよ"
    },
    {
      "start": 1755.6,
      "end": 1758.6,
      "text": "ほんと、ありがとう"
    },
    {
      "start": 1764.6,
      "end": 1769.6,
      "text": "女の学生が伝えたいことは何ですか?"
    },
    {
      "start": 1769.6,
      "end": 1771.6,
      "text": "1"
    },
    {
      "start": 1771.6,
      "end": 1776.6,
      "text": "佐藤君のバイトの仲間を紹介してほしい"
    },
    {
      "start": 1777.6,
      "end": 1778.6,
      "text": "2"
    },
    {
      "start": 1785.6,
      "end": 1786.6,
      "text": "3"
    },
    {
      "start": 1792.6,
      "end": 1793.6,
      "text": "4"
    },
    {
      "start": 1807.6,
      "end": 1810.6,
      "text": "2番"
    },
    {
      "start": 1810.6,
      "end": 1814.6,
      "text": "テレビで医者が話しています"
    },
    {
      "start": 1814.6,
      "end": 1821.6,
      "text": "私は患者さんからストレスや疲れで体の調子が良くないという相談を受けることがあります"
    },
    {
      "start": 1821.6,
      "end": 1825.6,
      "text": "皆さんは普段からよく笑っていますか"
    },
    {
      "start": 1825.6,
      "end": 1831.6,
      "text": "面白いテレビ番組を見たり楽しくおしゃべりしたりなんでもいいんです"
    },
    {
      "start": 1831.6,
      "end": 1833.6,
      "text": "笑うと緊張が溶けます"
    },
    {
      "start": 1834.6,
      "end": 1840.6,
      "text": "それにより血の流れが良くなり、元気になるという研究報告もあります"
    },
    {
      "start": 1840.6,
      "end": 1845.6,
      "text": "運動を始めるよりずっと簡単なことですから、ぜひやってみてください"
    },
    {
      "start": 1850.6,
      "end": 1853.6,
      "text": "医者が言いたいことは何ですか?"
    },
    {
      "start": 1853.6,
      "end": 1855.6,
      "text": "1"
    },
    {
      "start": 1855.6,
      "end": 1859.6,
      "text": "体の疲れは医者に相談したほうがいい"
    },
    {
      "start": 1861.6,
      "end": 1862.6,
      "text": "2"
    },
    {
