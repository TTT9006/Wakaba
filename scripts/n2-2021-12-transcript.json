      "end": 2334.06,
      "text": "なるほど"
    },
    {
      "start": 2334.06,
      "end": 2336.06,
      "text": "でもそれだと読んだことがある本が"
    },
    {
      "start": 2336.06,
      "end": 2338.06,
      "text": "入ってるってこともありますよね"
    },
    {
      "start": 2338.06,
      "end": 2342.06,
      "text": "その時は交換できるようにしたらいいですよ"
    },
    {
      "start": 2343.06,
      "end": 2346.06,
      "text": "まずは今やっている関内の研究会を"
    },
    {
      "start": 2346.06,
      "end": 2349.06,
      "text": "ホームページとかでもっと先伝するのはどうですか"
    },
    {
      "start": 2349.06,
      "end": 2353.06,
      "text": "これまでもホームページやチラシで"
    },
    {
      "start": 2353.06,
      "end": 2355.06,
      "text": "十分先伝してきてますからね"
    },
    {
      "start": 2355.06,
      "end": 2359.06,
      "text": "それなら親子で参加できるイベントを増やしたらどうですか"
    },
    {
      "start": 2359.06,
      "end": 2363.06,
      "text": "今は定期的にやってる工作やおりがみの教室"
    },
    {
      "start": 2363.06,
      "end": 2366.06,
      "text": "いつも人気で点いっぱいですよね"
    },
    {
      "start": 2366.06,
      "end": 2369.06,
      "text": "そうするとイベント当日は"
    },
    {
      "start": 2369.06,
      "end": 2372.06,
      "text": "職員の数を増やす必要が出てくるし"
    },
    {
      "start": 2372.06,
      "end": 2375.06,
      "text": "準備の負担も増えますね"
    },
    {
      "start": 2375.06,
      "end": 2377.06,
      "text": "ポイントカードの制度は"
    },
    {
      "start": 2377.06,
      "end": 2380.06,
      "text": "敬日がかかるからこの際やめてもいいかなって"
    },
    {
      "start": 2380.06,
      "end": 2381.06,
      "text": "思ってるんです"
    },
    {
      "start": 2381.06,
      "end": 2384.06,
      "text": "今回はテマも敬日も少なくて"
    },
    {
      "start": 2384.06,
      "end": 2387.06,
      "text": "済みそうなさっきのユニークな案"
    },
    {
      "start": 2387.06,
      "end": 2389.06,
      "text": "試してみましょう"
    },
    {
      "start": 2394.06,
      "end": 2396.06,
      "text": "年間の利用者を増やすために"
    },
    {
      "start": 2396.06,
      "end": 2398.06,
      "text": "何をすることにしましたか"
    },
    {
      "start": 2400.06,
      "end": 2401.06,
      "text": "1"
    },
    {
      "start": 2401.06,
      "end": 2404.06,
      "text": "ポイントと交換するしなものを変える"
    },
    {
      "start": 2407.06,
      "end": 2408.06,
      "text": "2"
    },
    {
      "start": 2408.06,
      "end": 2411.06,
      "text": "テーマごとに本を袋に入れてかし出す"
    },
    {
      "start": 2414.06,
      "end": 2415.06,
      "text": "3"
    },
    {
      "start": 2415.06,
      "end": 2418.06,
      "text": "見学会の宣伝に力を入れる"
    },
    {
      "start": 2421.06,
      "end": 2422.06,
      "text": "4"
    },
    {
      "start": 2422.06,
      "end": 2425.06,
      "text": "親子で参加できるイベントを増やす"
    },
    {
      "start": 2426.06,
      "end": 2427.06,
      "text": "4"
    },
    {
      "start": 2427.06,
      "end": 2428.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2428.06,
      "end": 2429.06,
      "text": "4"
    },
    {
      "start": 2429.06,
      "end": 2430.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2430.06,
      "end": 2431.06,
      "text": "4"
    },
    {
      "start": 2431.06,
      "end": 2432.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2432.06,
      "end": 2433.06,
      "text": "4"
    },
    {
      "start": 2433.06,
      "end": 2434.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2434.06,
      "end": 2435.06,
      "text": "4"
    },
    {
      "start": 2435.06,
      "end": 2436.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2436.06,
      "end": 2437.06,
      "text": "4"
    },
    {
      "start": 2437.06,
      "end": 2440.06,
      "text": "親子で参加できる"
    },
    {
      "start": 2441.06,
      "end": 2444.06,
      "text": "まず話を聞いてください"
    },
    {
      "start": 2444.06,
      "end": 2448.06,
      "text": "それから2つの質問を聞いて"
    },
    {
      "start": 2448.06,
      "end": 2451.06,
      "text": "それぞれ問題様子の"
    },
    {
      "start": 2451.06,
      "end": 2453.06,
      "text": "1から4の中から"
    },
    {
      "start": 2453.06,
      "end": 2455.06,
      "text": "最も良いものを"
    },
    {
      "start": 2455.06,
      "end": 2457.06,
      "text": "1つ選んでください"
    },
    {
      "start": 2460.06,
      "end": 2462.06,
      "text": "では始めます"
    },
    {
      "start": 2468.06,
      "end": 2470.06,
      "text": "市民運動公園で"
    },
    {
      "start": 2470.06,
      "end": 2474.06,
      "text": "係の人がイベントの説明をしています"
    },
    {
      "start": 2476.06,
      "end": 2480.06,
      "text": "本日の防災フェアは4つの会場に分かれています"
    },
    {
      "start": 2480.06,
      "end": 2482.06,
      "text": "第一会場の体育館では"
    },
    {
      "start": 2482.06,
      "end": 2485.06,
      "text": "災害地けがをした災の多久手当てを"
    },
    {
      "start": 2485.06,
      "end": 2487.06,
      "text": "実際に体験できます"
    },
    {
      "start": 2487.06,
      "end": 2489.06,
      "text": "第二会場の運動場では"
    },
    {
      "start": 2489.06,
      "end": 2493.06,
      "text": "ヘリコプターのリリック訓練をご覧いただけます"
    },
    {
      "start": 2493.06,
      "end": 2495.06,
      "text": "選択10名の方は"
    },
    {
      "start": 2495.06,
      "end": 2498.06,
      "text": "実際にヘリコプターに乗ることもできます"
    },
    {
      "start": 2498.06,
      "end": 2502.06,
      "text": "ただし18歳以上の方に限ります"
    },
    {
      "start": 2502.06,
      "end": 2503.06,
      "text": "えーそれから"
    },
    {
      "start": 2503.06,
      "end": 2505.06,
      "text": "第三会場の中車場では"
    },
    {
      "start": 2505.06,
      "end": 2507.06,
      "text": "消防車を展示しており"
    },
    {
      "start": 2507.06,
      "end": 2509.06,
      "text": "運転席に座ってみることができます"
    },
    {
      "start": 2511.06,
      "end": 2513.06,
      "text": "第4会場のプールでは"
    },
    {
      "start": 2513.06,
      "end": 2514.06,
      "text": "午後1時より"
    },
    {
      "start": 2514.06,
      "end": 2518.06,
      "text": "服を着たままおよぐ訓練をご覧いただけます"
    },
    {
      "start": 2518.06,
      "end": 2520.06,
      "text": "各会場での体験や"
    },
    {
      "start": 2520.06,
      "end": 2522.06,
      "text": "見学を通して"
    },
    {
      "start": 2522.06,
      "end": 2525.06,
      "text": "防災について学んでいただきたいと思います"
    },
    {
      "start": 2527.06,
      "end": 2529.06,
      "text": "えーいろいろあるんだね"
    },
    {
      "start": 2529.06,
      "end": 2532.06,
      "text": "ヘリコプターなんてなかなか乗れないから"
    },
    {
      "start": 2532.06,
      "end": 2533.06,
      "text": "乗ってみたいな"
    },
    {
      "start": 2533.06,
      "end": 2534.06,
      "text": "行ってみない?"
    },
    {
      "start": 2534.06,
      "end": 2537.06,
      "text": "私は高いところに逃げたから"
    },
    {
      "start": 2537.06,
      "end": 2538.06,
      "text": "下で見てるね"
    },
    {
      "start": 2538.06,
      "end": 2541.06,
      "text": "えーじゃあ消防車にしようか"
    },
    {
      "start": 2541.06,
      "end": 2543.06,
      "text": "せっかくどこら乗りたいのに乗ったら"
    },
    {
      "start": 2543.06,
      "end": 2545.06,
      "text": "選択順どこら"
    },
    {
      "start": 2545.06,
      "end": 2546.06,
      "text": "急いで行こう"
    },
    {
      "start": 2546.06,
      "end": 2547.06,
      "text": "わかった"
    },
    {
      "start": 2547.06,
      "end": 2549.06,
      "text": "他にどこか行きたいところある?"
    },
    {
      "start": 2549.06,
      "end": 2552.06,
      "text": "服を着たままおよぐっていうのを興味あるけど"
    },
    {
      "start": 2552.06,
      "end": 2554.06,
      "text": "あと3時間もあるから"
    },
    {
      "start": 2554.06,
      "end": 2556.06,
      "text": "大きい手当てはどう?"
    },
    {
      "start": 2556.06,
      "end": 2557.06,
      "text": "役立ちそうだし"
    },
    {
      "start": 2557.06,
      "end": 2558.06,
      "text": "そうだね"
    },
    {
      "start": 2558.06,
      "end": 2560.06,
      "text": "じゃあ次はそれに行こう"
    },
    {
      "start": 2561.06,
      "end": 2565.06,
      "text": "2人はまずどこへ行きますか"
    },
    {
      "start": 2565.06,
      "end": 2569.06,
      "text": "2人は次にどこへ行きますか?"
    }
  ]
}