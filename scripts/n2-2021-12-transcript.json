{
  "source": "c:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N2\\ĐỀ JLPT N2\\ĐỀ JLPT N2\\Đề 4\\Nghe N2 T12-2021 Ver 2.0 (đã bổ sung mondai 3 câu 5 bản chuẩn Yuuki Bùi).mp3",
  "duration": 2602.92025,
  "segments": [
    {
      "start": 0.0,
      "end": 23.36,
      "text": "本題一ではまず質問を聞いてください それから話を聞いて 問題用紙の一から4の中から"
    },
    {
      "start": 23.36,
      "end": 28.88,
      "text": "もっともよいものを一つ選んでください"
    },
    {
      "start": 30.88,
      "end": 34.56,
      "text": "では始めます"
    },
    {
      "start": 38.88,
      "end": 47.12,
      "text": "一番 音楽教室の事務室で 女の社員と男の社員が話しています"
    },
    {
      "start": 47.12,
      "end": 52.32,
      "text": "男の社員はこの後まず何をしますか"
    },
    {
      "start": 52.48,
      "end": 56.48,
      "text": "あのちょっと頼みたい事があるんだけど 何でしょうか"
    },
    {
      "start": 56.48,
      "end": 60.96,
      "text": "初級ギターのグループレッスンを受講している山田さんから電話があって"
    },
    {
      "start": 60.96,
      "end": 66.64,
      "text": "次のレッスンから曜日を日曜から土曜日のクラスに変更したいって"
    },
    {
      "start": 66.64,
      "end": 70.96,
      "text": "土曜も初級クラスは同じキムラ先生が担当なんだけどね"
    },
    {
      "start": 70.96,
      "end": 74.8,
      "text": "じゃあまず規模するクラスが相手いるか確認しましょうか"
    },
    {
      "start": 75.28,
      "end": 80.56,
      "text": "それは大丈夫だったただテキストと先生が同じでもクラスによって"
    },
    {
      "start": 80.56,
      "end": 86.48,
      "text": "進む速さが違う場合もあるでしょ山田さんに次何をやるのかって聞かれて"
    },
    {
      "start": 86.48,
      "end": 90.8,
      "text": "はい それで先生に電話して確かめてもらえないかな"
    },
    {
      "start": 90.8,
      "end": 93.52,
      "text": "でそれを山田さんに伝えてくれる"
    },
    {
      "start": 93.52,
      "end": 97.8,
      "text": "今日私相対するので わかりました山田さんへの連絡が"
    },
    {
      "start": 97.8,
      "end": 102.36,
      "text": "山田さんから自行性の名簿の修正も 指といてもらえると助かるんだけど"
    },
    {
      "start": 102.36,
      "end": 103.36,
      "text": "はい"
    },
    {
      "start": 108.64,
      "end": 113.12,
      "text": "男のシャインはこの後まず何をしますか"
    },
    {
      "start": 127.8,
      "end": 135.64,
      "text": "2番 公園で職員が課団を作るボランティアの人に話しています"
    },
    {
      "start": 135.64,
      "end": 140.68,
      "text": "ボランティアの人はまず何をしますか"
    },
    {
      "start": 142.76,
      "end": 146.68,
      "text": "午後のボランティアの皆さんよろしくお願いします"
    },
    {
      "start": 146.68,
      "end": 151.8,
      "text": "午前の方には雑草を抜いて課団の整備をしていただきました"
    },
    {
      "start": 151.8,
      "end": 158.4,
      "text": "午後は鼻の内を植えていただきます 内と内は感覚を開けて植えていくので"
    },
    {
      "start": 158.4,
      "end": 163.12,
      "text": "今からこちらの職員が植える場所のメジルシーをつけていきます"
    },
    {
      "start": 163.12,
      "end": 170.36,
      "text": "その間に皆さんには私と一緒にそちらの倉庫から鼻の内を運んでいただきます"
    },
    {
      "start": 170.36,
      "end": 177.16,
      "text": "とりあえず課団の前に置いていってください その後職員がつけたメジルシーに合わせて"
    },
    {
      "start": 177.16,
      "end": 180.36,
      "text": "内を並べていきます"
    },
    {
      "start": 186.36,
      "end": 191.56,
      "text": "ボランティアの人はまず何をしますか"
    },
    {
      "start": 191.56,
      "end": 211.88,
      "text": "サンバン 女の留学生と男の留学生が話しています"
    },
    {
      "start": 211.88,
      "end": 217.6,
      "text": "女の留学生はいらなくなったものをどうしますか"
    },
    {
      "start": 217.6,
      "end": 225.6,
      "text": "いよいよ卒業だね。国に帰るんで、カングとか電気製品いらなくなるんだけど、どうしたらいいかなぁ。"
    },
    {
      "start": 225.6,
      "end": 229.6,
      "text": "僕の場合は、アルバイト先の友達にゆずるんだ。"
    },
    {
      "start": 229.6,
      "end": 235.6,
      "text": "それはいいね。私のもまだ十分使えるから、捨てるのをもったいなくて。"
    },
    {
      "start": 235.6,
      "end": 243.6,
      "text": "この間、大学のケージ番で見たんだけど、先輩の顔引き取って、進入性に上げる活動しているボランティア団体があるんだって。"
    },
    {
      "start": 243.6,
      "end": 247.1,
      "text": "連絡すれば取りに来てくれるから、そこに寄付すれば?"
    },
    {
      "start": 247.1,
      "end": 249.1,
      "text": "えー、いいね。"
    },
    {
      "start": 249.1,
      "end": 253.1,
      "text": "それか、リサイクルショップに売るっていうのもいいよね。"
    },
    {
      "start": 253.1,
      "end": 257.1,
      "text": "ああ、だけど、電気製品の古いのは買い取ってくれないかも。"
    },
    {
      "start": 257.1,
      "end": 259.1,
      "text": "そうなんだ。"
    },
    {
      "start": 259.1,
      "end": 266.1,
      "text": "あ、インターネットでの販売はどう?写真のせて、買いたい人と直接やり取りするやつ。"
    },
    {
      "start": 266.1,
      "end": 271.1,
      "text": "お店まで持っていく必要がないから、楽でいいかなって思ったんだけど。"
    },
    {
      "start": 271.1,
      "end": 278.1,
      "text": "ああ、それは避けた方がいいと思うよ。受け渡しとかお金のこととか、トラブルもあるって聞くし。"
    },
    {
      "start": 278.1,
      "end": 279.1,
      "text": "そっか。"
    },
    {
      "start": 279.1,
      "end": 284.1,
      "text": "やっぱり、新人生に喜んでもらうのがいいんじゃない?手間かかんないし。"
    },
    {
      "start": 284.1,
      "end": 286.1,
      "text": "うん。じゃあ、そうしよう。"
    },
    {
      "start": 291.1,
      "end": 296.1,
      "text": "女の留学生は、いらなくなったものをどうしますか?"
    },
    {
      "start": 302.1,
      "end": 305.1,
      "text": "4番"
    },
    {
      "start": 313.1,
      "end": 319.1,
      "text": "大学で、学生と先生が、スピーチの現行について話しています。"
    },
    {
      "start": 319.1,
      "end": 325.1,
      "text": "学生はまず、現行のどこを直しますか?"
    },
    {
      "start": 325.1,
      "end": 330.1,
      "text": "先生、昨日、スピーチの現行を送らせていただいたんですが、"
    },
    {
      "start": 330.1,
      "end": 332.1,
      "text": "ああ、はい、見ましたよ。"
    },
    {
      "start": 332.1,
      "end": 338.1,
      "text": "いかがでしょうか。全体の構成があまり良くないんじゃないかと思うんですが。"
    },
    {
      "start": 338.1,
      "end": 344.1,
      "text": "うん。構成は悪くないと思いますよ。分かりやすくかけていますし、"
    },
    {
      "start": 344.1,
      "end": 353.1,
      "text": "ただ、導入の部分詳しく書いてあっていいんですが、全体の長さを考えると、もう少し関係ずにした方がいいですね。"
    },
    {
      "start": 353.1,
      "end": 362.1,
      "text": "あ、長いですか。真ん中の、私の経験を書いた部分も、もう少し短くした方がいいでしょうか?"
    },
    {
      "start": 362.1,
      "end": 369.1,
      "text": "うん。具体的な経験が書いてある部分は大事なところなので、このままでいいと思いますよ。"
    },
    {
      "start": 369.1,
      "end": 374.1,
      "text": "そうですか。最後のまとめの部分はどうでしょうか?"
    },
    {
      "start": 374.1,
      "end": 377.1,
      "text": "自分の意見をまとめてあって、よく書けてますよ。"
    },
    {
      "start": 378.1,
      "end": 384.1,
      "text": "ここはもう少し長くてもいいような気がしますが、全体がこれ以上長くなるとよくないので、"
    },
    {
      "start": 384.1,
      "end": 386.1,
      "text": "とりあえずこのままにしましょう。"
    },
    {
      "start": 386.1,
      "end": 389.1,
      "text": "はい、わかりました。じゃあすぐ直します。"
    },
    {
      "start": 389.1,
      "end": 391.1,
      "text": "ありがとうございました。"
    },
    {
      "start": 397.1,
      "end": 401.1,
      "text": "学生はまず、現行のどこを直しますか?"
    },
    {
      "start": 408.1,
      "end": 410.1,
      "text": "5番"
    },
    {
      "start": 416.1,
      "end": 418.1,
      "text": "5番"
    },
    {
      "start": 418.1,
      "end": 425.1,
      "text": "男の人と女の人がコンピューターを見ながら飛行機の席を選んでいます。"
    },
    {
      "start": 425.1,
      "end": 432.1,
      "text": "男の人はどの席を選ぶことにしますか?男の人です。"
    },
    {
      "start": 433.1,
      "end": 437.1,
      "text": "この白いのが相手いる席ってことですよね。"
    },
    {
      "start": 437.1,
      "end": 445.1,
      "text": "あ、そうだね。窓側がゆっくりできるからいいんだけど、並んで座れるところはあるかな。"
    },
    {
      "start": 445.1,
      "end": 447.1,
      "text": "できればうち合わせもしたいし。"
    },
    {
      "start": 447.1,
      "end": 456.1,
      "text": "そうですね。一つが窓側でしかも並べるところですと、一番後ろになりますね。"
    },
    {
      "start": 456.1,
      "end": 461.1,
      "text": "でも、一番後ろって座席が倒せないから苦しいんだよね。"
    },
    {
      "start": 461.1,
      "end": 470.1,
      "text": "ああ、そうなんですか。じゃあ、あと並んで座れるのはこの通路側のところですね。"
    },
    {
      "start": 470.1,
      "end": 473.1,
      "text": "うん、仕方ないか。"
    },
    {
      "start": 473.1,
      "end": 478.1,
      "text": "窓側だと、ここに一つ会ってますね。"
    },
    {
      "start": 478.1,
      "end": 482.1,
      "text": "私はその斜め前の席にしますよ。"
    },
    {
      "start": 482.1,
      "end": 487.1,
      "text": "もしかしたら私の隣の人が家庁の席と変わってくれるかもしれないですから。"
    },
    {
      "start": 487.1,
      "end": 494.1,
      "text": "そうだね。そうしたら並べるか。じゃあ、そうしよう。"
    },
    {
      "start": 498.1,
      "end": 504.1,
      "text": "男の人はどの席を選ぶことにしましたか。"
    },
    {
      "start": 518.1,
      "end": 529.1,
      "text": "問題2。問題2では、まず質問を聞いてください。"
    },
    {
      "start": 529.1,
      "end": 538.1,
      "text": "その後、問題用紙の選択肢を読んでください。読む時間があります。"
    },
    {
      "start": 538.1,
      "end": 551.1,
      "text": "それから話を聞いて、問題用紙の1から4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 551.1,
      "end": 556.1,
      "text": "では、始めます。"
    },
    {
      "start": 560.1,
      "end": 562.1,
      "text": "一番"
    },
    {
      "start": 562.1,
      "end": 566.1,
      "text": "女の人と男の人が話しています。"
    },
    {
      "start": 566.1,
      "end": 572.1,
      "text": "男の人が家でトマトを育てているのはどうしてですか。"
    },
    {
      "start": 593.1,
      "end": 596.1,
      "text": "これなに?"
    },
    {
      "start": 596.1,
      "end": 600.1,
      "text": "トマトだよ。最近作り始めたんだ。"
    },
    {
      "start": 600.1,
      "end": 606.1,
      "text": "おいしそうね。でも、どうして?納薬とか心配だから?"
    },
    {
      "start": 606.1,
      "end": 611.1,
      "text": "そうだね。外で買う野菜はたくさん納薬がかかってるかな。"
    },
    {
      "start": 611.1,
      "end": 615.1,
      "text": "うちで作った方が安心だって言う人も多いよね。"
    },
    {
      "start": 615.1,
      "end": 619.1,
      "text": "でも、僕はあまり気にしてないんだけど。"
    },
    {
      "start": 619.1,
      "end": 623.1,
      "text": "じゃあ、家庭の節約?"
    },
    {
      "start": 623.1,
      "end": 627.1,
      "text": "これくらいの節約にならないよ。"
    },
    {
      "start": 627.1,
      "end": 633.1,
      "text": "これは、息子が何か野菜を作りたいって言ってやってるんだ。"
    },
    {
      "start": 633.1,
      "end": 638.1,
      "text": "確か、小学生だよね。すごいね。"
    },
    {
      "start": 643.1,
      "end": 648.1,
      "text": "男の人が家でトマトを育てているのはどうしてですか。"
    },
    {
      "start": 650.1,
      "end": 653.1,
      "text": "2番"
    },
    {
      "start": 663.1,
      "end": 665.1,
      "text": "2番"
    },
    {
      "start": 665.1,
      "end": 670.1,
      "text": "大学で女の学生と男の学生が話しています。"
    },
    {
      "start": 670.1,
      "end": 678.1,
      "text": "男の学生はどうしてアルバイト先をベストランに変えたと言っていますか。"
    },
    {
      "start": 679.1,
      "end": 683.1,
      "text": "3番"
    },
    {
      "start": 699.1,
      "end": 704.1,
      "text": "高橋君、こんばん一緒にご飯食べに行かない?"
    },
    {
      "start": 704.1,
      "end": 708.1,
      "text": "悪い。夜はレストランでウェイターのバイトなんだ。"
    },
    {
      "start": 708.1,
      "end": 713.1,
      "text": "あれ?男橋君、ジュクの講師やってるって言ってなかった?"
    },
    {
      "start": 713.1,
      "end": 718.1,
      "text": "これから就職の準備で忙しくなるから、今月からバイト変えたんだ。"
    },
    {
      "start": 718.1,
      "end": 722.1,
      "text": "ジュクは時急もいいし楽しかったんだけどね。"
    },
    {
      "start": 722.1,
      "end": 725.1,
      "text": "ジュクのシフト減らしてもらえば良かったんじゃない?"
    },
    {
      "start": 725.1,
      "end": 733.1,
      "text": "ジュクで一緒に働いてた友達にもそう言われたんだけど、ジュクって決まった曜日と時間開けておかなきゃいけないでしょ。"
    },
    {
      "start": 733.1,
      "end": 740.1,
      "text": "メンセスが入ったり、先輩とあったりするから、スケジュールが流動的でも対応できる方がいいと思って。"
    },
    {
      "start": 740.1,
      "end": 745.1,
      "text": "今のバイト先は一週間ごとに予定を提出すればいいんだ。"
    },
    {
      "start": 745.1,
      "end": 751.1,
      "text": "そうか、新しい仕事だと覚えることも多くて大変そうだね。"
    },
    {
      "start": 751.1,
      "end": 754.1,
      "text": "まあ、これもいい経験だよ。"
    },
    {
      "start": 754.1,
      "end": 766.1,
      "text": "男の学生は、どうしてアルバイト先をレストランに変えたと言っていますか?"
    },
    {
      "start": 766.1,
      "end": 773.1,
      "text": "3番"
    },
    {
      "start": 773.1,
      "end": 787.1,
      "text": "大学の日本語のクラスで先生が留学生に話しています。"
    },
    {
      "start": 787.1,
      "end": 794.1,
      "text": "先生はレポートで何ができていない人が多かったと言っていますか?"
    },
    {
      "start": 794.1,
      "end": 798.1,
      "text": "考えません。"
    },
    {
      "start": 798.1,
      "end": 810.1,
      "text": "今回は勲まれにある音が止まったな。"
    },
    {
      "start": 810.1,
      "end": 817.1,
      "text": "後ろの子が使用しています。"
    },
    {
      "start": 817.1,
      "end": 821.1,
      "text": "この間書いてもらったレポートを返します。"
    },
    {
      "start": 821.1,
      "end": 825.9,
      "text": "環境問題について自分の考察を書き ましたね"
    },
    {
      "start": 825.9,
      "end": 831.1,
      "text": "引用した資料は皆さん信頼できる ものを使って書けていました"
    },
    {
      "start": 831.1,
      "end": 836.94,
      "text": "ただ考察が自分の考えなのか 資料にある分を引用したのかが"
    },
    {
      "start": 836.94,
      "end": 841.62,
      "text": "曖昧なレポートが多く見られた ので次からはこの点に気をつけ"
    },
    {
      "start": 841.62,
      "end": 847.62,
      "text": "ましょ 授業で注意した分体の統一 については話し言葉が"
    },
    {
      "start": 847.62,
      "end": 852.7,
      "text": "混ざることはなくかけていました 前回は決められた文字数を超える"
    },
    {
      "start": 852.7,
      "end": 858.38,
      "text": "人がいましたが今回は皆さん決めら れた文字数の中でうまくまとめられて"
    },
    {
      "start": 858.38,
      "end": 865.18,
      "text": "いました"
    },
    {
      "start": 865.18,
      "end": 870.26,
      "text": "先生はレポートで何ができていない 人が多かったと言っていますか"
    },
    {
      "start": 877.62,
      "end": 886.62,
      "text": "4番"
    },
    {
      "start": 886.62,
      "end": 894.62,
      "text": "フリーマーケットの会場で女の学生 と男の学生が話しています"
    },
    {
      "start": 894.62,
      "end": 898.46,
      "text": "二人は明日新たに何をする ことにしましたか"
    },
    {
      "start": 907.62,
      "end": 930.34,
      "text": "フリーマーケット1日目お疲れ様 福予想以上に売れたね"
    },
    {
      "start": 930.34,
      "end": 935.5,
      "text": "シャツとかズボンとか服の種類 サイズ別に分けて見やすく並べたのが"
    },
    {
      "start": 935.5,
      "end": 940.58,
      "text": "よかったんじゃないそうだね 明日はどうしようか"
    },
    {
      "start": 940.58,
      "end": 945.58,
      "text": "今日隣の店が色々とに分けてた のを見て見た目綺麗だから"
    },
    {
      "start": 945.58,
      "end": 948.86,
      "text": "あんな並べ方するのもいいかな って思ったんだ"
    },
    {
      "start": 948.86,
      "end": 954.06,
      "text": "うん色の種類がそんなにあるわけ じゃないしそこまでしなくていいよ"
    },
    {
      "start": 954.06,
      "end": 957.74,
      "text": "それより値段もう少し高い 設定でも良かったかも"
    },
    {
      "start": 957.74,
      "end": 962.54,
      "text": "でもお客さん喜んでくれてたよ ねふだわ変えなくていいん"
    },
    {
      "start": 962.54,
      "end": 968.06,
      "text": "じゃないじゃあそのままでいいか そういえば値段が高いのからやすい"
    },
    {
      "start": 968.06,
      "end": 971.7,
      "text": "のまでごちゃごちゃに置いてた のはよくなかったかもしれないね"
    },
    {
      "start": 971.7,
      "end": 977.38,
      "text": "そうだね サイズ別に分けてそれをさらに値段の順番で並べて"
    },
    {
      "start": 977.38,
      "end": 981.34,
      "text": "見るお客さんにしたらその方が いいかな"
    },
    {
      "start": 981.34,
      "end": 986.7,
      "text": "じゃあ明日の朝早めに来て取りかかろう"
    },
    {
      "start": 992.54,
      "end": 997.78,
      "text": "明日新たに何をすることにしました か"
    },
    {
      "start": 1011.54,
      "end": 1017.7,
      "text": "5番ラジオでアナウンサーが 店の紹介をしています"
    },
    {
      "start": 1017.7,
      "end": 1022.9,
      "text": "この店で売っている箱には何が 入っていますか"
    },
    {
      "start": 1022.9,
      "end": 1024.9,
      "text": "ん"
    },
    {
      "start": 1024.9,
      "end": 1026.9,
      "text": "ん"
    },
    {
      "start": 1026.9,
      "end": 1029.9,
      "text": "ん"
    },
    {
      "start": 1029.9,
      "end": 1032.9,
      "text": "ん"
    },
    {
      "start": 1032.9,
      "end": 1036.9,
      "text": "ん"
    },
    {
      "start": 1036.9,
      "end": 1040.9,
      "text": "ん"
    },
    {
      "start": 1040.9,
      "end": 1044.9,
      "text": "ん"
    },
    {
      "start": 1044.9,
      "end": 1050.34,
      "text": "ええけさは最近話題になっている お店に来ています"
    },
    {
      "start": 1050.34,
      "end": 1055.94,
      "text": "お店に入りますとまるでカフェの ような落ち着いた雰囲気です"
    },
    {
      "start": 1055.94,
      "end": 1059.94,
      "text": "店内にはプレゼント用の箱が並んでいます"
    },
    {
      "start": 1059.94,
      "end": 1064.82,
      "text": "おかしが入っていそうな箱や 放射器箱のようなものもあります"
    },
    {
      "start": 1064.82,
      "end": 1069.9,
      "text": "私もまさかこの箱に花が入っている とは思いませんでした"
    },
    {
      "start": 1069.9,
      "end": 1074.66,
      "text": "カフェのような店ですし箱には コーヒーが入っていると思われる方も"
    },
    {
      "start": 1074.66,
      "end": 1077.66,
      "text": "多いそうです"
    },
    {
      "start": 1081.34,
      "end": 1087.34,
      "text": "この店で売っている箱には何が 入っていますか"
    },
    {
      "start": 1100.34,
      "end": 1102.34,
      "text": "6番"
    },
    {
      "start": 1102.34,
      "end": 1106.94,
      "text": "ラジオで女のアナウンサーと社長が 話しています"
    },
    {
      "start": 1106.94,
      "end": 1111.94,
      "text": "社長は今どうやってストレスを 解消していますか"
    },
    {
      "start": 1111.94,
      "end": 1113.94,
      "text": "ん"
    },
    {
      "start": 1113.94,
      "end": 1115.94,
      "text": "ん"
    },
    {
      "start": 1115.94,
      "end": 1117.94,
      "text": "ん"
    },
    {
      "start": 1117.94,
      "end": 1118.94,
      "text": "ん"
    },
    {
      "start": 1118.94,
      "end": 1120.94,
      "text": "ん"
    },
    {
      "start": 1120.94,
      "end": 1123.94,
      "text": "ん"
    },
    {
      "start": 1123.94,
      "end": 1124.94,
      "text": "ん"
    },
    {
      "start": 1124.94,
      "end": 1125.94,
      "text": "ん"
    },
    {
      "start": 1125.94,
      "end": 1126.94,
      "text": "ん"
    },
    {
      "start": 1126.94,
      "end": 1129.94,
      "text": "ん"
    },
    {
      "start": 1129.94,
      "end": 1132.94,
      "text": "ん"
    },
    {
      "start": 1132.94,
      "end": 1133.94,
      "text": "ん"
    },
    {
      "start": 1134.34,
      "end": 1139.78,
      "text": "ただか社長けい車という 立場はストレスが多いと思いますが"
    },
    {
      "start": 1139.78,
      "end": 1142.94,
      "text": "どうやってストレスを 解消していらっしゃるんですか"
    },
    {
      "start": 1142.94,
      "end": 1144.46,
      "text": "そうですね"
    },
    {
      "start": 1144.46,
      "end": 1148.46,
      "text": "若い頃は仲間と一緒に サッカーをしていっぱいやって"
    },
    {
      "start": 1148.46,
      "end": 1151.14,
      "text": "予感さにはすっきりストレス 解消していました"
    },
    {
      "start": 1151.14,
      "end": 1152.0,
      "text": "ああ"
    },
    {
      "start": 1152.0,
      "end": 1153.38,
      "text": "サッカーですか"
    },
    {
      "start": 1153.38,
      "end": 1157.06,
      "text": "最近は友人がランニングを はじめて体にもいいし"
    },
    {
      "start": 1157.06,
      "end": 1160.66,
      "text": "汗を流してストレス 解消にもなるからって so 滑られたんですけど"
    },
    {
      "start": 1160.66,
      "end": 1162.18,
      "text": "なかなか"
    },
    {
      "start": 1162.18,
      "end": 1165.82,
      "text": "で、毎日1時間ほど歩くことにしてみたんです"
    },
    {
      "start": 1165.82,
      "end": 1167.26,
      "text": "そうですか?"
    },
    {
      "start": 1167.26,
      "end": 1169.58,
      "text": "かないもん一緒に始めたんですよ"
    },
    {
      "start": 1169.58,
      "end": 1173.22,
      "text": "体を動かしながらいろいろ話をするようになって"
    },
    {
      "start": 1173.22,
      "end": 1175.42,
      "text": "それが結構楽しくてね"
    },
    {
      "start": 1175.42,
      "end": 1178.22,
      "text": "体定の嫌なことは忘れられるんです"
    },
    {
      "start": 1178.22,
      "end": 1184.06,
      "text": "今では家族と旅行に行った時も旅行先で楽しんでいます"
    },
    {
      "start": 1185.06,
      "end": 1192.06,
      "text": "社長は今、どうやってストレスを解消していますか?"
    },
    {
      "start": 1207.06,
      "end": 1209.06,
      "text": "ここで、ちょっと休みましょう"
    },
    {
      "start": 1245.06,
      "end": 1246.06,
      "text": "問題3"
    },
    {
      "start": 1250.06,
      "end": 1252.06,
      "text": "問題3"
    },
    {
      "start": 1252.06,
      "end": 1259.06,
      "text": "問題3では、問題を知り、何も印刷されていません"
    },
    {
      "start": 1259.06,
      "end": 1266.06,
      "text": "この問題は、全体としてどんな内容化を聞く問題です"
    },
    {
      "start": 1266.06,
      "end": 1271.06,
      "text": "話の前に、質問はありません"
    },
    {
      "start": 1271.06,
      "end": 1275.06,
      "text": "まず話を聞いてください"
    },
    {
      "start": 1275.06,
      "end": 1279.06,
      "text": "それから、質問と選択肢を聞いて"
    },
    {
      "start": 1279.06,
      "end": 1289.06,
      "text": "1から4の中から、最も良いものを一つ選んでください"
    },
    {
      "start": 1289.06,
      "end": 1295.06,
      "text": "では、始めます"
    },
    {
      "start": 1298.06,
      "end": 1300.06,
      "text": "1番"
    },
    {
      "start": 1300.06,
      "end": 1306.06,
      "text": "学校の事務室で、事務の人と学生が話しています"
    },
    {
      "start": 1306.06,
      "end": 1308.06,
      "text": "あの、ジョンです"
    },
    {
      "start": 1308.06,
      "end": 1312.06,
      "text": "事務に来るようにという形状を見てきました"
    },
    {
      "start": 1312.06,
      "end": 1314.06,
      "text": "あ、はい、ジョンさんですね"
    },
    {
      "start": 1314.06,
      "end": 1317.06,
      "text": "あの、なんでしょうか"
    },
    {
      "start": 1317.06,
      "end": 1320.06,
      "text": "事業料は先日支払いましたけど"
    },
    {
      "start": 1320.06,
      "end": 1323.06,
      "text": "それとも、小学金のことですか"
    },
    {
      "start": 1323.06,
      "end": 1326.06,
      "text": "あ、小学金はまだなんですけど"
    },
    {
      "start": 1326.06,
      "end": 1327.06,
      "text": "あ、はい"
    },
    {
      "start": 1327.06,
      "end": 1333.06,
      "text": "あの、ジョンさん、金曜日の佐藤先生の事業を取っていますよね"
    },
    {
      "start": 1333.06,
      "end": 1334.06,
      "text": "はい"
    },
    {
      "start": 1334.06,
      "end": 1343.06,
      "text": "その、先生が、あさっての金曜日、急にごつもが悪くなり、日程を変更したいというご連絡があったんですが"
    },
    {
      "start": 1343.06,
      "end": 1344.06,
      "text": "あ、はい"
    },
    {
      "start": 1344.06,
      "end": 1352.06,
      "text": "あの、来週の金曜日に、3時間続けて事業をなさり対策なんですが、大丈夫ですか"
    },
    {
      "start": 1352.06,
      "end": 1356.06,
      "text": "あ、はい、金曜日は先生の事業だけですから"
    },
    {
      "start": 1356.06,
      "end": 1358.06,
      "text": "そうですか"
    },
    {
      "start": 1358.06,
      "end": 1361.06,
      "text": "他の学生も問題ないそうですから"
    },
    {
      "start": 1361.06,
      "end": 1363.06,
      "text": "じゃあ、そういうことでお願いします"
    },
    {
      "start": 1363.06,
      "end": 1365.06,
      "text": "はい"
    },
    {
      "start": 1370.06,
      "end": 1374.06,
      "text": "事務の人の話の内容は、なんでしたか"
    },
    {
      "start": 1374.06,
      "end": 1376.06,
      "text": "1"
    },
    {
      "start": 1376.06,
      "end": 1380.06,
      "text": "担当教師の変更について"
    },
    {
      "start": 1380.06,
      "end": 1382.06,
      "text": "2"
    },
    {
      "start": 1382.06,
      "end": 1385.06,
      "text": "小学金の結果について"
    },
    {
      "start": 1387.06,
      "end": 1388.06,
      "text": "3"
    },
    {
      "start": 1388.06,
      "end": 1391.06,
      "text": "従業料の支払いについて"
    },
    {
      "start": 1393.06,
      "end": 1394.06,
      "text": "4"
    },
    {
      "start": 1394.06,
      "end": 1398.06,
      "text": "従業の日程の変更について"
    },
    {
      "start": 1405.06,
      "end": 1407.06,
      "text": "2番"
    },
    {
      "start": 1407.06,
      "end": 1413.06,
      "text": "女の人と男の人が、映画を見た後で感想を話しています"
    },
    {
      "start": 1414.06,
      "end": 1416.06,
      "text": "イイエがだったね"
    },
    {
      "start": 1416.06,
      "end": 1418.06,
      "text": "うん、そうですね"
    },
    {
      "start": 1418.06,
      "end": 1420.06,
      "text": "よくなかったの?"
    },
    {
      "start": 1420.06,
      "end": 1423.06,
      "text": "いや、そういうわけじゃないんだけど"
    },
    {
      "start": 1423.06,
      "end": 1424.06,
      "text": "そう"
    },
    {
      "start": 1424.06,
      "end": 1429.06,
      "text": "なんか、イイエが見ると気持ちが暗くなることってない?"
    },
    {
      "start": 1429.06,
      "end": 1432.06,
      "text": "え?そんなことないよ"
    },
    {
      "start": 1432.06,
      "end": 1435.06,
      "text": "あ、そう?"
    },
    {
      "start": 1435.06,
      "end": 1441.06,
      "text": "僕は、自分の人生って何なんだろうとか考えちゃうんだよね"
    },
    {
      "start": 1441.06,
      "end": 1444.06,
      "text": "で、こう気分がね"
    },
    {
      "start": 1444.06,
      "end": 1447.06,
      "text": "うん、そうなんだ"
    },
    {
      "start": 1447.06,
      "end": 1450.06,
      "text": "じゃあ、よくない映画だったらどう?"
    },
    {
      "start": 1450.06,
      "end": 1454.06,
      "text": "それは、無駄な時間使ったなって暗くなっちゃうよ"
    },
    {
      "start": 1454.06,
      "end": 1459.06,
      "text": "なんだ、じゃあ、よくも悪くもない映画見るしかないね"
    },
    {
      "start": 1459.06,
      "end": 1463.06,
      "text": "いや、それはやっぱり、イイエが見たいよ"
    },
    {
      "start": 1466.06,
      "end": 1473.06,
      "text": "男の人は、この映画を見てどう感じましたか?"
    },
    {
      "start": 1473.06,
      "end": 1475.06,
      "text": "1"
    },
    {
      "start": 1475.06,
      "end": 1479.06,
      "text": "映画が良かったので、気分が沈んだ"
    },
    {
      "start": 1480.06,
      "end": 1482.06,
      "text": "2"
    },
    {
      "start": 1482.06,
      "end": 1486.06,
      "text": "映画はよくなかったけれど、楽しかった"
    },
    {
      "start": 1487.06,
      "end": 1489.06,
      "text": "3"
    },
    {
      "start": 1489.06,
      "end": 1493.06,
      "text": "映画がよくなかったので暗い気持ちになった"
    },
    {
      "start": 1495.06,
      "end": 1497.06,
      "text": "4"
    },
    {
      "start": 1497.06,
      "end": 1502.06,
      "text": "映画がよくも悪くもなかったので、楽しくない"
    },
    {
      "start": 1508.06,
      "end": 1510.06,
      "text": "3番"
    },
    {
      "start": 1510.06,
      "end": 1516.06,
      "text": "テレビ番組で、スポーツジムの指導員が話しています"
    },
    {
      "start": 1516.06,
      "end": 1521.06,
      "text": "スポーツジムなどで、体を着帯て金肉を付けようという方から"
    },
    {
      "start": 1521.06,
      "end": 1526.06,
      "text": "テレーニングをしても思うように金肉がつかないという声を聞くことがあります"
    },
    {
      "start": 1526.06,
      "end": 1529.06,
      "text": "おそらく、やり方が適切でないのでしょう"
    },
    {
      "start": 1529.06,
      "end": 1532.06,
      "text": "運動量が多ければいいというものではありません"
    },
    {
      "start": 1532.06,
      "end": 1537.06,
      "text": "どのトレーニングも基本的なやり方としては1セット10回"
    },
    {
      "start": 1537.06,
      "end": 1542.06,
      "text": "間に2分程度の休憩を挟みつつ2、3セットやるのが効果的です"
    },
    {
      "start": 1542.06,
      "end": 1546.06,
      "text": "やりすぎは体に広が着席され逆効果です"
    },
    {
      "start": 1546.06,
      "end": 1555.06,
      "text": "また、一度トレーニングをしたら48時間ほど時間を置いて金肉を休ませることも大切です"
    },
    {
      "start": 1559.06,
      "end": 1565.06,
      "text": "スポーツジムの指導員は何について話していますか"
    },
    {
      "start": 1565.06,
      "end": 1566.06,
      "text": "1"
    },
    {
      "start": 1566.06,
      "end": 1571.06,
      "text": "トレーニングを続けることのメリット"
    },
    {
      "start": 1572.06,
      "end": 1573.06,
      "text": "2"
    },
    {
      "start": 1573.06,
      "end": 1577.06,
      "text": "トレーニングの効果的な方法"
    },
    {
      "start": 1578.06,
      "end": 1580.06,
      "text": "3"
    },
    {
      "start": 1580.06,
      "end": 1584.06,
      "text": "1日のうちでトレーニングに適した時間"
    },
    {
      "start": 1586.06,
      "end": 1587.06,
      "text": "4"
    },
    {
      "start": 1587.06,
      "end": 1591.06,
      "text": "トレーニングを行う重要性"
    },
    {
      "start": 1591.06,
      "end": 1593.06,
      "text": "4"
    },
    {
      "start": 1593.06,
      "end": 1595.06,
      "text": "トレーニングの効果的な方法"
    },
    {
      "start": 1595.06,
      "end": 1597.06,
      "text": "4"
    },
    {
      "start": 1597.06,
      "end": 1601.06,
      "text": "トレーニングの効果的な方法"
    },
    {
      "start": 1601.06,
      "end": 1603.06,
      "text": "4"
    },
    {
      "start": 1603.06,
      "end": 1610.06,
      "text": "ラジオでアナウンサーが作文コンクールについて話しています"
    },
    {
      "start": 1610.06,
      "end": 1617.06,
      "text": "作らしんぶんが毎年行っている小学生作文コンクールが今年も行われました"
    },
    {
      "start": 1617.06,
      "end": 1620.06,
      "text": "今年のテーマは家族です"
    },
    {
      "start": 1620.06,
      "end": 1631.06,
      "text": "多数の応募がありその中から大好きなおじいさんとの交流を書いた小学5年生の小林検査さんの作文が最優秀少に輝きました"
    },
    {
      "start": 1631.06,
      "end": 1638.06,
      "text": "おじいさんとかわした会話や一緒にはそんな時の様子がメニューかぶようにあざやかに描かれ"
    },
    {
