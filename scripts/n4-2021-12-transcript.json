{
  "source": "c:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N4\\n4\\n4\\12-2021\\Nghe N4 T12-2021 bản chuẩn Yuuki Bùi.mp3",
  "duration": 2327.19675,
  "segments": [
    {
      "start": 0.0,
      "end": 9.2,
      "text": "これから、音を聞いてください。"
    },
    {
      "start": 9.2,
      "end": 16.6,
      "text": "音がよく聞こえない時は、手を上げてください。"
    },
    {
      "start": 16.6,
      "end": 20.6,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 20.6,
      "end": 24.8,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 24.8,
      "end": 28.8,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 28.8,
      "end": 33.4,
      "text": "天気がいいから、散歩しましょう。"
    },
    {
      "start": 39.6,
      "end": 50.9,
      "text": "2021年、第2回、日本語能力試験、超快、N4"
    },
    {
      "start": 50.9,
      "end": 57.9,
      "text": "これから、N4の超快試験を始めます。"
    },
    {
      "start": 57.9,
      "end": 63.7,
      "text": "問題用士にメモを取ってもいいです。"
    },
    {
      "start": 63.7,
      "end": 69.3,
      "text": "問題用士を開けてください。"
    },
    {
      "start": 69.3,
      "end": 76.6,
      "text": "問題用士のページがない時は、手を上げてください。"
    },
    {
      "start": 76.6,
      "end": 82.6,
      "text": "問題がよく見えない時も、手を上げてください。"
    },
    {
      "start": 82.6,
      "end": 85.6,
      "text": "いつでもいいです。"
    },
    {
      "start": 88.3,
      "end": 92.3,
      "text": "問題1"
    },
    {
      "start": 92.3,
      "end": 99.8,
      "text": "問題1では、まず質問を聞いてください。"
    },
    {
      "start": 99.8,
      "end": 106.8,
      "text": "それから話を聞いて、問題用士の1から4の中から、"
    },
    {
      "start": 106.8,
      "end": 113.0,
      "text": "一番いいものを一つ選んでください。"
    },
    {
      "start": 113.0,
      "end": 117.0,
      "text": "では練習しましょう。"
    },
    {
      "start": 118.1,
      "end": 123.1,
      "text": "レー"
    },
    {
      "start": 123.1,
      "end": 127.1,
      "text": "男の人が女の人に電話をしています。"
    },
    {
      "start": 127.1,
      "end": 132.1,
      "text": "男の人は何を買って帰りますか?"
    },
    {
      "start": 132.1,
      "end": 136.4,
      "text": "これから帰るけど何か買って帰ろうか?"
    },
    {
      "start": 136.4,
      "end": 140.7,
      "text": "ありがとう。"
    },
    {
      "start": 140.7,
      "end": 143.0,
      "text": "牛乳、それから。"
    },
    {
      "start": 143.0,
      "end": 144.9,
      "text": "ちょっと待って。"
    },
    {
      "start": 145.0,
      "end": 147.1,
      "text": "牛乳は一本でいいの?"
    },
    {
      "start": 147.1,
      "end": 151.5,
      "text": "えっと、日本お願い。それからチーズ。"
    },
    {
      "start": 151.5,
      "end": 153.0,
      "text": "あれ?"
    },
    {
      "start": 153.0,
      "end": 155.6,
      "text": "チーズはまだたくさんあったよね。"
    },
    {
      "start": 155.6,
      "end": 159.5,
      "text": "ごめん、今日の昼に全部食べたの。"
    },
    {
      "start": 159.5,
      "end": 161.0,
      "text": "わかった。"
    },
    {
      "start": 161.0,
      "end": 164.5,
      "text": "じゃあ、買って帰るね。"
    },
    {
      "start": 168.5,
      "end": 173.5,
      "text": "男の人は何を買って帰りますか?"
    },
    {
      "start": 173.6,
      "end": 178.6,
      "text": "一番いいものは4番です。"
    },
    {
      "start": 178.6,
      "end": 186.6,
      "text": "回答用士の問題1の例のところを見てください。"
    },
    {
      "start": 186.6,
      "end": 196.9,
      "text": "一番いいものは4番ですから、答えはこのように書きます。"
    },
    {
      "start": 196.9,
      "end": 201.4,
      "text": "では、始めます。"
    },
    {
      "start": 204.5,
      "end": 207.0,
      "text": "一番"
    },
    {
      "start": 207.0,
      "end": 212.4,
      "text": "男の人が友達のうちで料理を手伝っています。"
    },
    {
      "start": 212.4,
      "end": 218.7,
      "text": "男の人は肉を入れた後に何を入れますか?"
    },
    {
      "start": 218.7,
      "end": 221.0,
      "text": "最初に何を入れるの?"
    },
    {
      "start": 221.0,
      "end": 223.2,
      "text": "その肉、入れて。"
    },
    {
      "start": 223.2,
      "end": 225.2,
      "text": "その次は野菜?"
    },
    {
      "start": 225.2,
      "end": 232.0,
      "text": "ちょっと待って。その前に砂糖を入れて、それから野菜。"
    },
    {
      "start": 232.1,
      "end": 236.9,
      "text": "それでは、次は水を入れて、最後は醤油ね。"
    },
    {
      "start": 236.9,
      "end": 239.9,
      "text": "うん、わかった。"
    },
    {
      "start": 244.5,
      "end": 251.0,
      "text": "男の人は肉を入れた後に何を入れますか?"
    },
    {
      "start": 263.0,
      "end": 266.0,
      "text": "二番"
    },
    {
      "start": 266.0,
      "end": 271.5,
      "text": "電話で、息子とお母さんが話しています。"
    },
    {
      "start": 271.5,
      "end": 276.5,
      "text": "息子はどのサンダルを買いますか?"
    },
    {
      "start": 276.5,
      "end": 281.0,
      "text": "もしもし、今、駅前の靴屋にいるんだけど、"
    },
    {
      "start": 281.0,
      "end": 286.5,
      "text": "前にお母さんが欲しいって言っていたサンダルが千円も安くなっているよ。"
    },
    {
      "start": 286.5,
      "end": 293.0,
      "text": "え、本当?買ってきて?白いのと黒いのと両方ある?"
    },
    {
      "start": 293.0,
      "end": 295.0,
      "text": "うん。どっちがいい?"
    },
    {
      "start": 295.0,
      "end": 302.5,
      "text": "白の方が黒い線が入っていて、かっこいいんだけど、よれやすいから黒にする。"
    },
    {
      "start": 302.5,
      "end": 304.0,
      "text": "わかった。"
    },
    {
      "start": 304.0,
      "end": 306.0,
      "text": "エムとエルがあるよ。"
    },
    {
      "start": 306.0,
      "end": 307.5,
      "text": "大規法にして?"
    },
    {
      "start": 307.5,
      "end": 313.0,
      "text": "そのサンダルは前に見せで入ったらエムは少し小さかったんだ。"
    },
    {
      "start": 313.0,
      "end": 315.0,
      "text": "わかった。"
    },
    {
      "start": 317.5,
      "end": 323.0,
      "text": "息子はどのサンダルを買いますか?"
    },
    {
      "start": 337.5,
      "end": 339.5,
      "text": "三番"
    },
    {
      "start": 339.5,
      "end": 343.5,
      "text": "女の人と男の人が話しています。"
    },
    {
      "start": 343.5,
      "end": 348.0,
      "text": "女の人は何をしますか?"
    },
    {
      "start": 348.0,
      "end": 352.0,
      "text": "明日のパーティー何か手伝わうことはない?"
    },
    {
      "start": 352.0,
      "end": 354.5,
      "text": "部屋は片付けてある?"
    },
    {
      "start": 354.5,
      "end": 358.5,
      "text": "大丈夫。明日の朝、掃除するつもりだから。"
    },
    {
      "start": 358.5,
      "end": 361.5,
      "text": "じゃあ、何か買っていこうか。"
    },
    {
      "start": 361.5,
      "end": 365.0,
      "text": "うん。食べ物はたくさんあるかなぁ。"
    },
    {
      "start": 365.0,
      "end": 368.0,
      "text": "じゃあ、飲み物お願い。"
    },
    {
      "start": 368.0,
      "end": 369.2,
      "text": "わかった。"
    },
    {
      "start": 369.2,
      "end": 370.7,
      "text": "他には?"
    },
    {
      "start": 370.7,
      "end": 373.7,
      "text": "料理は手伝わなくて大丈夫?"
    },
    {
      "start": 373.7,
      "end": 377.7,
      "text": "うん。料理は簡単なものだから。"
    },
    {
      "start": 382.2,
      "end": 386.7,
      "text": "女の人は何をしますか?"
    },
    {
      "start": 400.2,
      "end": 402.2,
      "text": "四番"
    },
    {
      "start": 402.2,
      "end": 408.7,
      "text": "ホテルの受け付けで女の人とホテルの人が話しています。"
    },
    {
      "start": 408.7,
      "end": 414.7,
      "text": "女の人はこの後まず何をしますか?"
    },
    {
      "start": 414.7,
      "end": 417.7,
      "text": "有約した森田です。"
    },
    {
      "start": 417.7,
      "end": 424.7,
      "text": "すみません。まだ掃除中でお部屋に案内できるまで1時間ぐらいかかってしまいます。"
    },
    {
      "start": 425.2,
      "end": 429.7,
      "text": "じゃあ、その間にホテルのスキー教室で並えますか?"
    },
    {
      "start": 429.7,
      "end": 433.7,
      "text": "はい。スキーのを服と道具はありますか?"
    },
    {
      "start": 433.7,
      "end": 435.7,
      "text": "両方借りられますか?"
    },
    {
      "start": 435.7,
      "end": 442.7,
      "text": "はい。隣の部屋に服がありますから、好きなのを選んで来て行ってください。"
    },
    {
      "start": 442.7,
      "end": 446.2,
      "text": "スキー教室はホテルの裏です。"
    },
    {
      "start": 446.2,
      "end": 449.2,
      "text": "道具は教室で借りられます。"
    },
    {
      "start": 449.2,
      "end": 454.2,
      "text": "両金は他の両金と一緒に帰りにお願いします。"
    },
    {
      "start": 454.2,
      "end": 455.2,
      "text": "わかりました。"
    },
    {
      "start": 455.2,
      "end": 459.2,
      "text": "あ、荷物はこちらに置いていきますか?"
    },
    {
      "start": 459.2,
      "end": 463.2,
      "text": "自分の車に入れておくので大丈夫です。"
    },
    {
      "start": 467.2,
      "end": 474.2,
      "text": "女の人はこの後まず何をしますか?"
    },
    {
      "start": 480.2,
      "end": 482.2,
      "text": "5番"
    },
    {
      "start": 482.2,
      "end": 486.2,
      "text": "男の学生と女の学生が話しています。"
    },
    {
      "start": 486.2,
      "end": 491.2,
      "text": "男の学生はこれからどこへ行きますか?"
    },
    {
      "start": 491.2,
      "end": 494.2,
      "text": "宿題の作文、出した?"
    },
    {
      "start": 494.2,
      "end": 497.2,
      "text": "私はもう出したよ?"
    },
    {
      "start": 497.2,
      "end": 501.2,
      "text": "早いね。作文を出す前に、"
    },
    {
      "start": 501.2,
      "end": 505.2,
      "text": "直したいところがあるんだけど、"
    },
    {
      "start": 505.2,
      "end": 508.2,
      "text": "自己を打ちに忘れてきたんだ。"
    },
    {
      "start": 508.2,
      "end": 510.2,
      "text": "持っている?"
    },
    {
      "start": 510.2,
      "end": 513.2,
      "text": "私も持っていないな。"
    },
    {
      "start": 513.2,
      "end": 515.2,
      "text": "きっと、都所管にあるよ。"
    },
    {
      "start": 515.2,
      "end": 517.2,
      "text": "そうか。"
    },
    {
      "start": 517.2,
      "end": 520.2,
      "text": "でも、都所管のは古いよ。"
    },
    {
      "start": 520.2,
      "end": 525.2,
      "text": "いつもの自己がいいから、やっぱり打ち帰ろう。"
    },
    {
      "start": 525.2,
      "end": 528.2,
      "text": "あ、私も持っていないな。"
    },
    {
      "start": 528.2,
      "end": 531.2,
      "text": "あ、やっぱり打ち帰ろう。"
    },
    {
      "start": 531.2,
      "end": 534.2,
      "text": "あ、やんさんも同じの持っているから、"
    },
    {
      "start": 534.2,
      "end": 537.2,
      "text": "借りられると思うよ。"
    },
    {
      "start": 537.2,
      "end": 540.2,
      "text": "次の事業があるから、教室にいると思う。"
    },
    {
      "start": 540.2,
      "end": 542.2,
      "text": "あ、そうか。"
    },
    {
      "start": 542.2,
      "end": 544.2,
      "text": "聞いてみるよ。"
    },
    {
      "start": 544.2,
      "end": 547.2,
      "text": "それから作文はどこに出すの?"
    },
    {
      "start": 547.2,
      "end": 549.2,
      "text": "自分所だよ。"
    },
    {
      "start": 549.2,
      "end": 551.2,
      "text": "ありがとう。"
    },
    {
      "start": 552.2,
      "end": 555.2,
      "text": "おとこの学生は、"
    },
    {
      "start": 555.2,
      "end": 558.2,
      "text": "これからどこへ行きますか?"
    },
    {
      "start": 575.2,
      "end": 576.2,
      "text": "6番"
    },
    {
      "start": 577.2,
      "end": 580.2,
      "text": "女の人と男の人が、"
    },
    {
      "start": 580.2,
      "end": 583.2,
      "text": "会議室で話しています。"
    },
    {
      "start": 583.2,
      "end": 587.2,
      "text": "男の人は何を片付けますか?"
    },
    {
      "start": 587.2,
      "end": 590.2,
      "text": "この部屋、会議で使うから、"
    },
    {
      "start": 590.2,
      "end": 593.2,
      "text": "いらないもの、片付けてくれる?"
    },
    {
      "start": 593.2,
      "end": 594.2,
      "text": "はい。"
    },
    {
      "start": 594.2,
      "end": 598.2,
      "text": "あの、廃森はどうしましょうか?"
    },
    {
      "start": 598.2,
      "end": 600.2,
      "text": "あ、おいたままでいいわ。"
    },
    {
      "start": 600.2,
      "end": 601.2,
      "text": "はい。"
    },
    {
      "start": 601.2,
      "end": 603.2,
      "text": "このコップは?"
    },
    {
      "start": 603.2,
      "end": 606.2,
      "text": "それはテーブルの上に並べて?"
    },
    {
      "start": 606.2,
      "end": 607.2,
      "text": "はい。"
    },
    {
      "start": 607.2,
      "end": 609.2,
      "text": "今日は花はいらないから。"
    },
    {
      "start": 609.2,
      "end": 613.2,
      "text": "じゃあ、壁には使いませんね。"
    },
    {
      "start": 613.2,
      "end": 615.2,
      "text": "パソコンはどうしましょう?"
    },
    {
      "start": 615.2,
      "end": 616.2,
      "text": "うん。"
    },
    {
      "start": 616.2,
      "end": 619.2,
      "text": "使うから、出しておいて。"
    },
    {
      "start": 623.2,
      "end": 625.2,
      "text": "男の人は、"
    },
    {
      "start": 625.2,
      "end": 628.2,
      "text": "何を片付けますか?"
    },
    {
      "start": 634.2,
      "end": 636.2,
      "text": "7番"
    },
    {
      "start": 636.2,
      "end": 638.2,
      "text": "日本語のクラスで、"
    },
    {
      "start": 638.2,
      "end": 642.2,
      "text": "先生が学生に話しています。"
    },
    {
      "start": 642.2,
      "end": 645.2,
      "text": "この授業で学生は、"
    },
    {
      "start": 645.2,
      "end": 647.2,
      "text": "自分で、"
    },
    {
      "start": 647.2,
      "end": 651.2,
      "text": "ノートをナウンサツ用意しますか?"
    },
    {
      "start": 651.2,
      "end": 655.2,
      "text": "授業は、来週から始まります。"
    },
    {
      "start": 663.2,
      "end": 666.2,
      "text": "教科書は、日本語一と、"
    },
    {
      "start": 666.2,
      "end": 669.2,
      "text": "漢字一というのを使います。"
    },
    {
      "start": 669.2,
      "end": 672.2,
      "text": "ノートは、国版を打つのに、"
    },
    {
      "start": 672.2,
      "end": 674.2,
      "text": "一冊必要です。"
    },
    {
      "start": 674.2,
      "end": 675.2,
      "text": "他に、"
    },
    {
      "start": 675.2,
      "end": 679.2,
      "text": "毎週作文をノートに書いて出してもらうので、"
    },
    {
      "start": 679.2,
      "end": 683.2,
      "text": "作文のノートを一冊用意してください。"
    },
    {
      "start": 683.2,
      "end": 686.2,
      "text": "漢字の練習に使うノートは、"
    },
    {
      "start": 686.2,
      "end": 688.2,
      "text": "学校が用意して、"
    },
    {
      "start": 688.2,
      "end": 690.2,
      "text": "皆さんに渡します。"
    },
    {
      "start": 690.2,
      "end": 692.2,
      "text": "漢字のノートは、"
    },
    {
      "start": 692.2,
      "end": 694.2,
      "text": "一年で3冊使いますが、"
    },
    {
      "start": 694.2,
      "end": 699.2,
      "text": "来週は初めの一冊だけ渡します。"
    },
    {
      "start": 703.2,
      "end": 706.2,
      "text": "この授業で学生は、"
    },
    {
      "start": 706.2,
      "end": 708.2,
      "text": "自分で、"
    },
    {
      "start": 708.2,
      "end": 712.2,
      "text": "ノートをナウンサツ用意しますか?"
    },
    {
      "start": 721.2,
      "end": 724.2,
      "text": "8番"
    },
    {
      "start": 724.2,
      "end": 728.2,
      "text": "コンビニで、"
    },
    {
      "start": 728.2,
      "end": 734.2,
      "text": "店の人とアルバイトの女の学生が話しています。"
    },
    {
      "start": 734.2,
      "end": 736.2,
      "text": "女の学生は、"
    },
    {
      "start": 736.2,
      "end": 738.2,
