generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  password String
  name String
  avatar String @default("花")
  role String @default("user")
  goal Int @default(20)
  level String @default("N5")
  theme String @default("light")
  annotationMode String @default("japanese")
  defaultDeckVersion Int @default(0)
  createdAt DateTime @default(now())
  sessions Session[]
  decks Deck[]
  reviews Review[]
  progress GrammarProgress[]
  attempts Attempt[]
  writings Writing[]
  testRuns TestRun[]
  searches SearchHistory[]
  radicals RadicalProgress[]
  grammarExercises GrammarExerciseProgress[]
  grammarAnswers GrammarAnswer[]
  passwordCredentials UserPasswordCredential[]
  loginReview LoginReview?
  seasonRanks SeasonRank[]
  dailyExps DailyExp[]
}
model UserPasswordCredential {
  id String @id @default(cuid())
  userId String
  password String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,password])
}
model AccountImport {
  source String @id
  completedAt DateTime @default(now())
}
model Session {
  token String @id
  userId String
  expires DateTime
  reviewReady Boolean @default(false)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model LoginReview {
  userId String @id
  state String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Deck {
  id String @id @default(cuid())
  userId String
  name String
  description String @default("")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  cards Card[]
}
model Card {
  id String @id @default(cuid())
  deckId String
  japanese String
  reading String
  meaning String
  english String @default("")
  note String @default("")
  example String @default("")
  entryId String?
  materialType String @default("vocabulary")
  radicalId Int?
  ease Float @default(2.5)
  interval Int @default(0)
  repetitions Int @default(0)
  due DateTime @default(now())
  lastReviewed DateTime?
  deck Deck @relation(fields:[deckId],references:[id],onDelete:Cascade)
  reviews Review[]
  @@index([deckId,due])
  @@unique([deckId,radicalId])
}
model Review {
  id String @id @default(cuid())
  userId String
  cardId String
  rating Int
  interval Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  card Card @relation(fields:[cardId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model Grammar {
  id String @id
  pattern String
  title String
  level String
  position Int
  content String
  exercises String
  progress GrammarProgress[]
  exerciseProgress GrammarExerciseProgress[]
  answers GrammarAnswer[]
}
model GrammarExerciseProgress {
  id String @id @default(cuid())
  userId String
  grammarId String
  exerciseId String
  attempts Int @default(0)
  correctCount Int @default(0)
  lastCorrect Boolean @default(false)
  ease Float @default(2.5)
  interval Int @default(0)
  repetitions Int @default(0)
  due DateTime @default(now())
  lastReviewed DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  grammar Grammar @relation(fields:[grammarId],references:[id],onDelete:Cascade)
  @@unique([userId,grammarId,exerciseId])
  @@index([userId,due])
}
model GrammarAnswer {
  id String @id
  userId String
  grammarId String
  exerciseId String
  answer String
  correct Boolean
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  grammar Grammar @relation(fields:[grammarId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model GrammarProgress {
  id String @id @default(cuid())
  userId String
  grammarId String
  completed Boolean @default(false)
  bookmarked Boolean @default(false)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  grammar Grammar @relation(fields:[grammarId],references:[id],onDelete:Cascade)
  @@unique([userId,grammarId])
}
model Attempt {
  id String @id @default(cuid())
  userId String
  testId String
  score Float
  answers String
  duration Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model TestRun {
  id String @id @default(cuid())
  userId String
  testId String
  questions String
  startedAt DateTime @default(now())
  submitted Boolean @default(false)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model SearchHistory {
  id String @id @default(cuid())
  userId String
  query String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model Writing {
  id String @id @default(cuid())
  userId String
  character String
  strokes String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model DictionaryEntry {
  id String @id
  common Boolean
  version String
  raw String
  kanji DictionaryKanji[]
  readings DictionaryReading[]
  senses DictionarySense[]
}
model DictionaryKanji {
  id String @id
  entryId String
  text String
  normalized String
  common Boolean
  information String
  entry DictionaryEntry @relation(fields:[entryId],references:[id],onDelete:Cascade)
  @@index([normalized])
  @@index([text,entryId])
  @@index([entryId])
}
model DictionaryReading {
  id String @id
  entryId String
  text String
  normalized String
  common Boolean
  information String
  restrictions String
  entry DictionaryEntry @relation(fields:[entryId],references:[id],onDelete:Cascade)
  @@index([normalized])
  @@index([text,entryId])
  @@index([entryId])
}
model DictionarySense {
  id String @id
  entryId String
  senseIndex Int
  metadata String
  entry DictionaryEntry @relation(fields:[entryId],references:[id],onDelete:Cascade)
  glosses DictionaryGloss[]
  @@index([entryId])
}
model DictionaryGloss {
  id String @id
  senseId String
  glossIndex Int
  language String
  originalText String
  glossType String?
  sourceHash String
  sense DictionarySense @relation(fields:[senseId],references:[id],onDelete:Cascade)
  translation DictionaryTranslation?
  @@index([senseId])
}
model DictionaryTranslation {
  id String @id @default(cuid())
  glossId String @unique
  targetLanguage String @default("vi")
  translatedText String
  status String @default("completed")
  provider String
  model String
  sourceHash String
  translatedAt DateTime @default(now())
  reviewedAt DateTime?
  errorMessage String?
  gloss DictionaryGloss @relation(fields:[glossId],references:[id],onDelete:Cascade)
  @@index([sourceHash])
}
model DictionaryImport {
  id String @id @default(cuid())
  version String
  source String
  checksum String
  count Int
  status String
  importedAt DateTime @default(now())
}
model TranslationJob {
  id String @id @default(cuid())
  status String
  total Int
  processed Int @default(0)
  successful Int @default(0)
  failed Int @default(0)
  lastError String?
  startedAt DateTime @default(now())
  completedAt DateTime?
}
model SearchReindex {
  entryId String @id
}
model RadicalProgress {
  userId String
  radicalId Int
  completed Boolean @default(false)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,radicalId])
}
model Season {
  id String @id
  year Int
  month Int
  title String
  startedAt DateTime
  endedAt DateTime
  settled Boolean @default(false)
  ranks SeasonRank[]
}

model SeasonRank {
  id String @id @default(cuid())
  seasonId String
  userId String
  rank Int
  exp Int
  kamonType String
  awardedAt DateTime @default(now())
  seenSummary Boolean @default(false)
  season Season @relation(fields:[seasonId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([seasonId,userId])
  @@index([seasonId,rank])
  @@index([userId])
}

model DailyExp {
  id String @id @default(cuid())
  userId String
  date String
  testExp Int @default(0)
  reviewExp Int @default(0)
  grammarExp Int @default(0)
  writingExp Int @default(0)
  streakExp Int @default(0)
  totalExp Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,date])
  @@index([userId,date])
}

model UserExpLog {
  id String @id @default(cuid())
  userId String
  date String
  activityType String
  referenceId String?
  amount Int
  createdAt DateTime @default(now())
  @@index([userId,date,activityType])
}
